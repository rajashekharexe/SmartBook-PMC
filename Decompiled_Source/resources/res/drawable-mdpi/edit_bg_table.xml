<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:right="1dp"
        android:bottom="1dp">
        <shape
            android:dither="true"
            android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#7d7a7a"/>
            <solid android:color="@android:color/white"/>
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp"/>
        </shape>
    </item>
</layer-list>
