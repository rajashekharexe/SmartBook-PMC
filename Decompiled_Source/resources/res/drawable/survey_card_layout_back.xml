<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <corners android:radius="5dp"/>
            <solid android:color="@color/colorAccentHalf"/>
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape
            android:dither="true"
            android:shape="rectangle">
            <corners android:radius="2dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/colorAccentHalf"/>
            <solid android:color="@android:color/white"/>
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp"/>
        </shape>
    </item>
</layer-list>
