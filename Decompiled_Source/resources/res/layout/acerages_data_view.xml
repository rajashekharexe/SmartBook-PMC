<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">&quot; 
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/acerages"
            android:singleLine="true"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3">
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/pmc_old"
                android:singleLine="true"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:id="@+id/tv_acerages_new"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/pmc_new"
                android:singleLine="true"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="5dp"
            android:weightSum="3">
            <TextView
                android:textSize="12sp"
                android:gravity="center_horizontal"
                android:paddingBottom="3dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/pmc_heading_owned"
                android:layout_weight="1"/>
            <EditText
                android:id="@+id/et_owned_old_acreage"
                android:background="@drawable/edittext_small"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="20dp"
                android:layout_weight="1"
                style="@style/edit_text"/>
            <EditText
                android:id="@+id/et_owned_new_acreage"
                android:background="@drawable/edittext_small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:minHeight="20dp"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                style="@style/edit_text"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:weightSum="3">
        <TextView
            android:textSize="12sp"
            android:gravity="center_horizontal"
            android:paddingBottom="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/pmc_heading_leasedin"
            android:layout_weight="1"/>
        <EditText
            android:id="@+id/et_Leasedin_old_acreage"
            android:background="@drawable/edittext_small"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:layout_weight="1"
            style="@style/edit_text"/>
        <EditText
            android:id="@+id/et_Leasedin_new_acreage"
            android:background="@drawable/edittext_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:minHeight="20dp"
            android:layout_weight="1"
            style="@style/edit_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:weightSum="3">
        <TextView
            android:textSize="12sp"
            android:gravity="center_horizontal"
            android:paddingBottom="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/pmc_heading_leasedout"
            android:layout_weight="1"/>
        <EditText
            android:id="@+id/et_leasedout_old_acreage"
            android:background="@drawable/edittext_small"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:layout_weight="1"
            style="@style/edit_text"/>
        <EditText
            android:id="@+id/et_leasedout_new_acreage"
            android:background="@drawable/edittext_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:minHeight="20dp"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            style="@style/edit_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:weightSum="3">
        <TextView
            android:textSize="12sp"
            android:gravity="center_horizontal"
            android:paddingBottom="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/pmc_heading_cultivated"
            android:layout_weight="1"/>
        <EditText
            android:id="@+id/et_Cultivated_old_acreage"
            android:background="@drawable/edittext_small"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:layout_weight="1"
            style="@style/edit_text"/>
        <EditText
            android:id="@+id/et_Cultivated_new_acreage"
            android:background="@drawable/edittext_small"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:minHeight="20dp"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            style="@style/edit_text"/>
    </LinearLayout>
</LinearLayout>
