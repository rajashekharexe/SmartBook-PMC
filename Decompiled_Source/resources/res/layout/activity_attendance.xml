<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/toolbar"/>
    <com.conceptglobal.pmc.utils.Itext
        android:textSize="10sp"
        android:textColor="@color/red"
        android:gravity="center"
        android:id="@+id/tvDraftText"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_below="@+id/toolbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_above="@+id/llSaveBG"
        android:layout_below="@+id/tvDraftText">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_boarder">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvfromDate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/from_date"
                    android:layout_weight="0.4"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/etFromDate"
                    android:background="@drawable/edit_bg_custom"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:editable="false"
                    android:drawableRight="@drawable/datepicker_image"
                    android:layout_weight="0.6"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llActivityBG"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvLeaveType"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/reporting"
                    android:layout_weight="0.4"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/etLeaveType"
                    android:background="@drawable/edit_bg_custom"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:editable="false"
                    android:drawableRight="@drawable/drop_16"
                    android:layout_weight="0.6"
                    style="@style/edit_text"/>
                <com.conceptglobal.pmc.utils.Itext
                    android:id="@+id/tvLeaveTypeID"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/devider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvToDate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/to_date"
                    android:layout_weight="0.4"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/etToDate"
                    android:background="@drawable/edit_bg_custom"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:editable="false"
                    android:drawableRight="@drawable/datepicker_image"
                    android:layout_weight="0.6"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvNoOfDays"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/no_of_days"
                    android:layout_weight="0.4"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/etNoOfDays"
                    android:background="@drawable/edit_bg_custom"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:editable="false"
                    android:layout_weight="0.6"
                    android:inputType="number"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvReasonType"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/reason_type"
                    android:layout_weight="0.4"/>
                <com.conceptglobal.pmc.utils.Itext
                    android:id="@+id/tvReasonTypeID"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llStrtEndImageBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvTravelInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/attendance_travelInfo"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/lytNOC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="15dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="2">
                        <RelativeLayout
                            android:id="@+id/lytNOCImage1"
                            android:padding="10dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="17dp"
                            android:layout_weight="1">
                            <TextView
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:id="@+id/tvStartDay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Start KM"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/llstartLatnong"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_below="@+id/tvStartDay"
                                style="@style/edit_text_disable">
                                <LinearLayout
                                    android:gravity="right"
                                    android:layout_gravity="right"
                                    android:orientation="horizontal"
                                    android:id="@+id/llGeoLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    style="@style/edit_text_disable">
                                    <LinearLayout
                                        android:gravity="center"
                                        android:orientation="horizontal"
                                        android:background="@drawable/edt_disable"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.8">
                                        <com.conceptglobal.pmc.utils.Itext
                                            android:textSize="@dimen/text_size_14"
                                            android:gravity="left"
                                            android:id="@+id/tv_latitude_personal_details"
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_margin="5dp"
                                            android:hint="@string/pmc_label_latitude"
                                            android:layout_weight="0.4"/>
                                        <com.conceptglobal.pmc.utils.Itext
                                            android:textSize="@dimen/text_size_14"
                                            android:gravity="left"
                                            android:id="@+id/tv_longitude_personal_details"
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_margin="5dp"
                                            android:hint="@string/pmc_label_longitude"
                                            android:layout_weight="0.4"/>
                                    </LinearLayout>
                                    <ImageView
                                        android:id="@+id/btn_get_latlong_farmer_personal_details"
                                        android:background="@color/colorPrimary"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:src="@drawable/geo"
                                        android:layout_weight="0.2"/>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/llStartDateTime"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="51dp"
                                android:layout_marginTop="5dp"
                                android:layout_below="@+id/llstartLatnong">
                                <com.conceptglobal.pmc.utils.Itext
                                    android:textColor="@color/black"
                                    android:gravity="center"
                                    android:id="@+id/tvStartDateTime"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:text="@string/from_date"
                                    android:layout_weight="0.4"/>
                                <com.conceptglobal.pmc.utils.Iedit
                                    android:id="@+id/etStartDateTime"
                                    android:background="@drawable/edit_bg_custom"
                                    android:focusable="false"
                                    android:clickable="false"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:editable="false"
                                    android:drawableRight="@drawable/datepicker_image"
                                    android:layout_weight="0.6"
                                    style="@style/edit_text"/>
                            </LinearLayout>
                            <RelativeLayout
                                android:id="@+id/ivStartBG"
                                android:background="@drawable/bg_dashed_rectangle"
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:layout_marginTop="5dp"
                                android:layout_below="@+id/tvStartDay">
                                <ImageView
                                    android:id="@+id/ivCamera1"
                                    android:padding="10dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="51dp"
                                    android:layout_centerInParent="true"
                                    android:alpha="0.5"
                                    app:srcCompat="@drawable/ic_camera_btn"/>
                                <ImageView
                                    android:id="@+id/ivNOC1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </RelativeLayout>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/lytNOCImage2"
                            android:padding="10dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="7dp"
                            android:layout_weight="1">
                            <TextView
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:id="@+id/tvEndDay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="End KM"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/llEndLatlong"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_below="@+id/tvEndDay"
                                style="@style/edit_text_disable">
                                <LinearLayout
                                    android:gravity="right"
                                    android:layout_gravity="right"
                                    android:orientation="horizontal"
                                    android:id="@+id/llEndTimeGeoLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    style="@style/edit_text_disable">
                                    <LinearLayout
                                        android:gravity="center"
                                        android:orientation="horizontal"
                                        android:background="@drawable/edt_disable"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.8">
                                        <com.conceptglobal.pmc.utils.Itext
                                            android:textSize="@dimen/text_size_14"
                                            android:gravity="left"
                                            android:id="@+id/tv_EndTime_latitude_personal_details"
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_margin="5dp"
                                            android:hint="@string/pmc_label_latitude"
                                            android:layout_weight="0.4"/>
                                        <com.conceptglobal.pmc.utils.Itext
                                            android:textSize="@dimen/text_size_14"
                                            android:gravity="left"
                                            android:id="@+id/tv_EndTime_longitude_personal_details"
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_margin="5dp"
                                            android:hint="@string/pmc_label_longitude"
                                            android:layout_weight="0.4"/>
                                    </LinearLayout>
                                    <ImageView
                                        android:id="@+id/btn_get_EndTime_latlong_farmer_personal_details"
                                        android:background="@color/colorPrimary"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:src="@drawable/geo"
                                        android:layout_weight="0.2"/>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/llEndDateTime"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="51dp"
                                android:layout_marginTop="5dp"
                                android:layout_below="@+id/llEndLatlong">
                                <com.conceptglobal.pmc.utils.Itext
                                    android:textColor="@color/black"
                                    android:gravity="center"
                                    android:id="@+id/tvEndDateTime"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:text="@string/from_date"
                                    android:layout_weight="0.4"/>
                                <com.conceptglobal.pmc.utils.Iedit
                                    android:id="@+id/etEndDateTime"
                                    android:background="@drawable/edit_bg_custom"
                                    android:focusable="false"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:editable="false"
                                    android:drawableRight="@drawable/datepicker_image"
                                    android:layout_weight="0.6"
                                    style="@style/edit_text"/>
                            </LinearLayout>
                            <RelativeLayout
                                android:id="@+id/ivEndBG"
                                android:background="@drawable/bg_dashed_rectangle"
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:layout_marginTop="5dp"
                                android:layout_below="@+id/tvEndDay">
                                <ImageView
                                    android:id="@+id/ivCamera2"
                                    android:padding="10dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/ic_camera_btn"
                                    android:layout_centerInParent="true"
                                    android:alpha="0.5"/>
                                <ImageView
                                    android:id="@+id/ivNOC2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </RelativeLayout>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tvStartLocation"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:text="Strat Location"
                    android:drawableRight="@drawable/geo"
                    android:layout_weight="1"
                    style="@style/btnStyleBreakerBay"/>
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tvEndLocation"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:text="End Location"
                    android:drawableRight="@drawable/geo"
                    android:layout_weight="1"
                    style="@style/btnStyleBreakerBay"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">
                <TextView
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvStartAddress"
                    android:background="@color/gray3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:hint="Address"
                    android:lines="2"
                    android:minLines="2"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvEndAddress"
                    android:background="@color/gray3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:hint="Address"
                    android:lines="2"
                    android:minLines="2"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvStartKM"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/attendance_startkm"
                    android:layout_weight="0.4"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/etStartKM"
                    android:background="@drawable/edit_bg_custom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLength="100"
                    android:layout_weight="0.6"
                    android:inputType="number"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvEndKM"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/attendance_endkm"
                    android:layout_weight="0.4"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/etEndKM"
                    android:background="@drawable/edit_bg_custom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLength="100"
                    android:layout_weight="0.6"
                    android:inputType="number"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvTotalDistance"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/attendance_distance"
                    android:layout_weight="0.4"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/etTotaldistance"
                    android:background="@drawable/edit_bg_custom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLength="10"
                    android:layout_weight="0.6"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvTravelType"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/attendance_nightHault"
                    android:layout_weight="0.4"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/etTravelType"
                    android:background="@drawable/edit_bg_custom"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:editable="false"
                    android:drawableRight="@drawable/drop_16"
                    android:layout_weight="0.6"
                    style="@style/edit_text"/>
                <com.conceptglobal.pmc.utils.Itext
                    android:id="@+id/tvTravelTypeID"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/devider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llExpenceView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tvTotalExpences"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/attendance_expenses"
                    android:layout_weight="0.4"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/etTotalExpences"
                    android:background="@drawable/edit_bg_custom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLength="100"
                    android:layout_weight="0.6"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rlExpenseImagesView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <GridView
                    android:gravity="center"
                    android:id="@+id/grid_expences"
                    android:scrollbars="none"
                    android:layout_width="wrap_content"
                    android:layout_height="100dp"
                    android:layout_marginTop="10dp"
                    android:horizontalSpacing="1dp"
                    android:verticalSpacing="10dp"
                    android:stretchMode="columnWidth"
                    android:columnWidth="150dp"
                    android:numColumns="5"
                    android:isScrollContainer="false"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="right"
        android:layout_width="357dp"
        android:layout_height="117dp"
        android:layout_marginTop="10dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <com.conceptglobal.imaterialdesign.widget.FloatingActionButton
            android:layout_gravity="end|bottom"
            android:id="@+id/fab"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/fab_margin"
            app:fab_iconSrc="@drawable/camera_img"
            app:v_styleId="@array/fab_icon"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llSaveBG"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1"
        android:layout_alignParentBottom="true">
        <com.conceptglobal.pmc.utils.Ibutton
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/btn_save_draft"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="37dp"
            android:layout_marginLeft="10dp"
            android:text="Draft"
            android:layout_weight="0.3"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            style="@style/btnStyleBreakerBay"/>
        <com.conceptglobal.pmc.utils.Ibutton
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/btn_save"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="20dp"
            android:text="Submit"
            android:layout_toRightOf="@+id/btn_save_draft"
            android:layout_centerHorizontal="true"
            style="@style/btnStyleBreakerBay"/>
        <com.conceptglobal.pmc.utils.Ibutton
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/btn_clear_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="2dp"
            android:text="Clear"
            android:layout_weight="0.3"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            style="@style/btnStyleBreakerBay"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llStartBG"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_weight="0.7"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <com.conceptglobal.pmc.utils.Ibutton
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btnStartDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start travel"
                android:foregroundGravity="center"
                style="@style/btnStyleBreakerBay"/>
            <com.conceptglobal.pmc.utils.Ibutton
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btnEndDay"
                android:background="@color/red"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Travel submission"
                android:foregroundGravity="center"
                style="@style/btnStyleBreakerBay"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
