<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.conceptglobal.pmc.utils.Itext
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/dicimilar"
        style="@style/text_slide_drawer"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <com.conceptglobal.pmc.utils.Ibutton
            android:textColor="@color/white"
            android:id="@+id/btn_agree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pmc_agree"
            style="@style/btnStyleBreakerBay"/>
        <com.conceptglobal.pmc.utils.Ibutton
            android:textColor="@color/white"
            android:id="@+id/btn_disagree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/pmc_disagree"
            style="@style/btnStyleBreakerBay"/>
        <com.conceptglobal.pmc.utils.Ibutton
            android:textColor="@color/white"
            android:id="@+id/btn_inactive_farmer_other_details"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/pmc_btn_Inactive"
            style="@style/btnStyleBreakerBay"/>
    </LinearLayout>
</LinearLayout>
