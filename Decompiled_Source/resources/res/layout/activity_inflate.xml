<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_boarder">
            <ListView
                android:id="@+id/lv_list_activity_inflate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_add_another_activity"
                android:background="@color/action_dark_blue"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="3dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/btn_add_another_activity"
                    android:padding="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/pmc_add_activity"
                    android:drawableRight="@drawable/ic_menu_btn_add"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
