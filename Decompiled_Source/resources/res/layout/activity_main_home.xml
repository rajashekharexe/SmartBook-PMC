<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/weatherParent_parent"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:layout_alignParentTop="true">
        <RelativeLayout
            android:id="@+id/weatherParent"
            android:background="@drawable/weatherbg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="280dp">
            <RelativeLayout
                android:id="@+id/getLocationLayout"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginRight="5dp"
                    android:layout_toLeftOf="@+id/getlocBtn">
                    <EditText
                        android:id="@+id/locEditWeather"
                        android:paddingLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Enter location"
                        android:layout_weight="1"/>
                    <com.conceptglobal.pmc.utils.Ibutton
                        android:textColor="@color/white"
                        android:id="@+id/getCityWeatherBtn"
                        android:layout_width="80dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:text="Go"
                        android:marqueeRepeatLimit="3"
                        style="@style/btnStyleBreakerBay"/>
                </LinearLayout>
                <ImageView
                    android:textColor="@color/white"
                    android:id="@+id/getlocBtn"
                    android:background="@color/colorPrimaryQuarter"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:src="@drawable/geo"
                    android:text="@string/pmc_label_get"
                    android:layout_weight="0.7"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/btnStyleBreakerBay"/>
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/weatherView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                android:layout_below="@+id/cityTextView"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"/>
            <RelativeLayout
                android:id="@+id/progressBar"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:layout_centerInParent="true">
                <ProgressBar
                    android:id="@+id/progressBar1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_centerVertical="true"
                    style="?android:attr/progressBarStyleSmall"/>
                <TextView
                    android:textSize="7sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="loading..."
                    android:layout_toRightOf="@+id/progressBar1"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <TextView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:id="@+id/noweatherText"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="weather not available..."
                android:layout_centerInParent="true"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/cityTextView"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="City"
                android:layout_below="@+id/getLocationLayout"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout> /&gt; 
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHomePageGrids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="5dp"
        android:layout_above="@+id/ll_ticker"
        android:layout_below="@+id/weatherParent_parent"
        android:layout_alignParentLeft="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_ticker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:id="@+id/txt_marketname"
            android:background="@color/colorPrimaryDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.conceptglobal.pmc.utils.ScrollTextView
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@+id/txt_price_display"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
    </LinearLayout>
</RelativeLayout>
