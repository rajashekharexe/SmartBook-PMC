<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_soil_type"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_add_village_soil_type"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_soil_type"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="@string/enter_here"
                    android:maxLength="6"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_sowing_from_date"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_add_village_sowing_window"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_sowing_from_date"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="@string/enter_here"
                    android:maxLength="6"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:background="@drawable/btn"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_heading_cultivated_reg"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_sowing_to_date"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="@string/enter_here"
                    android:maxLength="6"
                    android:layout_weight="0.4"
                    android:layout_alignParentRight="true"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_retailer1"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_add_village_retailer1"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_retailer1"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="@string/enter_here"
                    android:maxLength="6"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_retailer2"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_add_village_retailer2"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_retailer2"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="@string/enter_here"
                    android:maxLength="6"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_prominent_disease"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_add_village_prominent_disease"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_prominent_disease"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="@string/enter_here"
                    android:maxLength="6"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_prominent_insect"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_add_village_prominent_insect"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_prominent_insect"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="@string/enter_here"
                    android:maxLength="6"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
