<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TabHost
        android:id="@+id/add_village_tabhost"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@android:id/tabcontent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@android:id/tabs">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/new_village_tab1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include layout="@layout/reg_geography_tab"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/new_village_tab2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include layout="@layout/add_village_acreagedetails_tab"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/new_village_tab3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include layout="@layout/reg_geography_tab"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/new_village_tab4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include layout="@layout/add_village_others_tab"/>
                </LinearLayout>
            </FrameLayout>
            <TabWidget
                android:id="@android:id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </TabHost>
</LinearLayout>
