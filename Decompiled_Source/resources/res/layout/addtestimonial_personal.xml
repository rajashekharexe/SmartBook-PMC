<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/oprattributes_LL_main"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:id="@+id/ield_inspections_opr_scroll"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="right"
                    android:layout_gravity="right"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="0.4"
                    style="@style/edit_text_disable">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/edt_disable"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        style="@style/edit_text_disable">
                        <com.conceptglobal.pmc.utils.Itext
                            android:textSize="@dimen/text_size_14"
                            android:id="@+id/tv_latitude_personal_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:hint="@string/pmc_label_latitude"
                            android:layout_weight="0.5"/>
                        <com.conceptglobal.pmc.utils.Itext
                            android:textSize="@dimen/text_size_14"
                            android:id="@+id/tv_longitude_personal_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:hint="@string/pmc_label_longitude"
                            android:layout_weight="0.5"/>
                    </LinearLayout>
                    <ImageView
                        android:textColor="@color/white"
                        android:id="@+id/btn_get_latlong_farmer_personal_details"
                        android:background="@color/colorPrimaryQuarter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/geo"
                        android:text="@string/pmc_label_get"
                        android:layout_weight="0.7"
                        style="@style/btnStyleBreakerBay"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/operations_dynamic_LL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">
                    <com.conceptglobal.pmc.utils.Itext
                        android:textSize="@dimen/text_size_12"
                        android:textColor="@color/grey_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/edittext_height"
                        android:text="Coose Existing file"
                        android:layout_weight="0.6"
                        style="@style/text_hint"/>
                    <Button
                        android:textColor="@color/grey_text"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/btnSlectAndCompress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select File"
                        android:layout_weight="0.4"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.conceptglobal.pmc.utils.Itext
                        android:textSize="@dimen/text_size_12"
                        android:textColor="@color/grey_text"
                        android:id="@+id/tv_edtsubjects"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="@dimen/edittext_height"
                        android:text="Subject"
                        android:layout_weight="0.6"
                        style="@style/text_hint"/>
                    <com.conceptglobal.pmc.utils.Iedit
                        android:textSize="@dimen/text_size_12"
                        android:gravity="center"
                        android:id="@+id/edtsubject"
                        android:background="@drawable/edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/edittext_height"
                        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
                        android:layout_weight="0.4"
                        style="@style/edit_text"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.conceptglobal.pmc.utils.Itext
                        android:textSize="@dimen/text_size_12"
                        android:textColor="@color/grey_text"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_img_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/edittext_height"
                        android:text="Image"
                        android:layout_weight="0.6"
                        style="@style/text_hint"/>
                    <ImageView
                        android:id="@+id/img_preview"
                        android:background="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:src="0x7f080125"
                        android:layout_weight="0.4"/>
                </LinearLayout>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/retailer_personal_geodetails_LL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">
                    <com.conceptglobal.pmc.utils.Ibutton
                        android:textColor="@color/white"
                        android:id="@+id/btn_draft"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginLeft="10dp"
                        android:text="Draft"
                        style="@style/btnStyleBreakerBay"/>
                    <com.conceptglobal.pmc.utils.Ibutton
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:id="@+id/btn_save"
                        android:paddingLeft="5sp"
                        android:paddingRight="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Submit"
                        android:foregroundGravity="center_horizontal"
                        style="@style/btnStyleBreakerBay"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
