<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/img_round_edges"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tvFoDistance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="FO-Distance Travelled(KM)"
                android:layout_weight="0.4"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:id="@+id/etFoDistance"
                android:background="@drawable/edit_bg_custom"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:editable="false"
                android:layout_weight="0.6"
                android:inputType="number"
                style="@style/edit_text"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tvTravelledDistance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Distance Travelled(KM)"
                android:layout_weight="0.4"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:id="@+id/etTravelledDistance"
                android:background="@drawable/edit_bg_custom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:inputType="number"
                style="@style/edit_text"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tvFoNightHalt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="FO-Night Halt"
                android:layout_weight="0.4"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:id="@+id/etFoNightHalt"
                android:background="@drawable/edit_bg_custom"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:editable="false"
                android:drawableRight="@drawable/drop_16"
                android:layout_weight="0.6"
                style="@style/edit_text"/>
            <com.conceptglobal.pmc.utils.Itext
                android:id="@+id/tvFoNightHaltID"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tvNightHalt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Night Halt"
                android:layout_weight="0.4"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:id="@+id/etNightHalt"
                android:background="@drawable/edit_bg_custom"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:editable="false"
                android:drawableRight="@drawable/drop_16"
                android:layout_weight="0.6"
                style="@style/edit_text"/>
            <com.conceptglobal.pmc.utils.Itext
                android:id="@+id/tvNightHaltID"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/btn_cancel_alert"
                android:background="@drawable/btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/text_size_12"
                android:text="@string/pmc_cancel"/>
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/btn_save_and_approve"
                android:background="@drawable/btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/text_size_12"
                android:text="@string/pmc_approvr_save"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
