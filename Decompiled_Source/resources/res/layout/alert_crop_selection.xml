<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/img_round_edges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.conceptglobal.pmc.utils.Iedit
            android:textSize="@dimen/text_size_12"
            android:id="@+id/et_crop_crop_alert"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:hint="@string/pmc_add_crop"
            android:ems="15"
            android:editable="false"
            android:layout_weight="1"
            android:inputType="none"/>
        <TextView
            android:id="@+id/tvcropid"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <com.conceptglobal.pmc.utils.Iedit
            android:textSize="@dimen/text_size_12"
            android:id="@+id/et_crop_type_alert"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:hint="@string/pmc_add_acreage_type"
            android:ems="15"
            android:editable="false"
            android:layout_weight="1"
            android:inputType="none"/>
        <TextView
            android:id="@+id/tvcrop_acrage_type_id"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <com.conceptglobal.pmc.utils.Iedit
            android:textSize="@dimen/text_size_12"
            android:id="@+id/et_crop_discription_crop_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:hint="@string/pmc_add_acreage"
            android:ems="15"
            android:layout_weight="1"/>
        <com.conceptglobal.pmc.utils.Iedit
            android:textSize="@dimen/text_size_12"
            android:id="@+id/et_crop_dos"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:hint="@string/pmc_add_crop"
            android:ems="15"
            android:editable="false"
            android:layout_weight="1"
            android:inputType="none"/>
        <com.conceptglobal.pmc.utils.Iedit
            android:textSize="@dimen/text_size_12"
            android:id="@+id/et_hybrid"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:hint="@string/pmc_add_hybrid"
            android:ems="15"
            android:editable="false"
            android:layout_weight="1"
            android:inputType="none"/>
        <TextView
            android:id="@+id/tvhybrid"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:weightSum="2">
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/btn_save_crop_alert"
                android:background="@drawable/btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pmc_save"
                android:layout_weight="1"/>
            <com.conceptglobal.pmc.utils.Ibutton
                android:id="@+id/btn_na"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="5dp"
                android:text="@string/pmc_na"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
