<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_24"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Day Start"
        android:textAlignment="center"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/img_round_edges"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.conceptglobal.pmc.utils.Iedit
            android:textSize="@dimen/text_size_12"
            android:id="@+id/etSelectmode"
            android:padding="10dp"
            android:focusable="false"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:hint="Select Mode"
            android:editable="false"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/tvSelectModeid"
            android:layout_width="wrap_content"
            android:layout_height="0dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:weightSum="2">
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/btnCancel"
                android:background="@drawable/btn"
                android:visibility="gone"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/cancel"
                android:layout_weight="1"/>
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/btnStartDay"
                android:background="@drawable/btn"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="Start Day"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
