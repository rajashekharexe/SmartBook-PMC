<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/img_round_edges"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.conceptglobal.pmc.utils.Iedit
            android:textSize="@dimen/text_size_12"
            android:id="@+id/etDistance"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:hint="Enter Travel Distance"
            android:layout_weight="1"
            android:inputType="numberDecimal"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:padding="10dp"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/pmc_endday_description"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:weightSum="2">
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/btnCloseEndDay"
                android:background="@drawable/btn"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="Close"
                android:layout_weight="1"/>
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/btnEndDay"
                android:background="@drawable/btn"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/ok"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
