<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mobilenumll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/img_round_edges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.imaterialdesign.widget.TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp">
                <com.conceptglobal.imaterialdesign.widget.EditText
                    android:id="@+id/et_mobile_alert_forgot_pwd"
                    android:paddingLeft="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableLeft="@drawable/ic_action_not_secure"
                    android:imeOptions="actionDone"
                    app:et_inputId="@+id/textfield_et_helper_input"
                    app:et_supportMode="helper"
                    app:v_styleId="@array/edittext"/>
                <com.conceptglobal.imaterialdesign.widget.EditText
                    android:id="@+id/emptedit"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.conceptglobal.imaterialdesign.widget.Button
                    android:id="@+id/btn_ok_alert_forgot_pwd"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/pmc_ok"
                    app:v_styleId="@array/button_raise_wave_color"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/userdetailsll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.imaterialdesign.widget.TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pmc_label_your_name"
                android:layout_weight="0.3"
                app:v_styleId="@array/text_title"/>
            <com.conceptglobal.imaterialdesign.widget.TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/blue_gray"
                android:id="@+id/tv_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                app:v_styleId="@array/text_body"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.conceptglobal.imaterialdesign.widget.TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pmc_label_your_pwd"
                android:layout_weight="0.3"
                app:v_styleId="@array/text_title"/>
            <com.conceptglobal.imaterialdesign.widget.TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/blue_gray"
                android:id="@+id/tv_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                app:v_styleId="@array/text_body"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
