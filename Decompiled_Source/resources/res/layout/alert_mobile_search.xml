<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="40dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/img_round_edges"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.conceptglobal.pmc.utils.Itext
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tvMobileNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/enter_valid_mobile_number"
            android:layout_weight="1"/>
        <com.conceptglobal.pmc.utils.Iedit
            android:textSize="@dimen/text_size_12"
            android:id="@+id/etMobileNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:hint="@string/enter_mobile_number"
            android:ems="15"
            android:maxLength="10"
            android:layout_weight="1"
            android:inputType="number"/>
        <com.conceptglobal.pmc.utils.Iedit
            android:textSize="@dimen/text_size_12"
            android:id="@+id/etGstNumber"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:hint="@string/enter_gst"
            android:ems="15"
            android:maxLength="10"
            android:layout_weight="1"
            android:inputType="text"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:weightSum="2">
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/btn_cancel_alert"
                android:background="@drawable/btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="@string/pmc_cancel"
                android:layout_weight="1"/>
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/btn_search_alert"
                android:background="@drawable/btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="@string/search_online"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
