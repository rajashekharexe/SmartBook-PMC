<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="2dp"
    android:layout_marginRight="5dp">
    <ImageView
        android:id="@+id/content_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        app:srcCompat="0x7f080168"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_content_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paddy Harvesting Machine "
        android:layout_toRightOf="@+id/content_type"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/grey"
        android:id="@+id/tv_content_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="It is an engine operated, walk behind type harvester suitable for harvesting"
        android:layout_below="@+id/content_type"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/frame"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/tv_content_desc">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/chip"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/file_name"
            android:background="@color/white"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pdf.pdf"
            android:drawableLeft="0x7f080168"
            android:drawablePadding="10dp"/>
        <TextView
            android:textStyle="bold"
            android:layout_gravity="bottom|right"
            android:id="@+id/size"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1"
        android:layout_below="@+id/frame">
        <com.conceptglobal.pmc.promotions.utils.FlowLayout
            android:orientation="horizontal"
            android:id="@+id/chipsBoxLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_weight="0.8"
            app:flChildSpacing="5dp"
            app:flChildSpacingForLastRow="align"
            app:flRowSpacing="8dp"/>
        <com.conceptglobal.pmc.promotions.utils.ArrowDownloadButton
            android:layout_gravity="end"
            android:id="@+id/download"
            android:visibility="visible"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_weight="0.2"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/delete"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_weight="0.2"
            app:srcCompat="0x7f080135"/>
    </LinearLayout>
    <View
        android:background="@color/grey"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/llChips"/>
</RelativeLayout>
