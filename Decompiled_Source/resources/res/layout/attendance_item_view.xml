<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/card_layout_back_rating"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp">
    <CheckBox
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/cbArroveAttendance"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="0.1"
        android:foregroundGravity="center"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/text_tab_unselected"
            android:id="@+id/tvAttendanceDate"
            android:padding="1dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/text_tab_unselected"
            android:id="@+id/tvAttendanceDistance"
            android:padding="1dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/text_tab_unselected"
            android:id="@+id/tvAttendanceNightHalt"
            android:padding="1dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>
    </LinearLayout>
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ivEditAttendance"
        android:padding="5dp"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_todo"
        android:tint="@color/text_tab_unselected"
        android:layout_weight="0.1"/>
</LinearLayout>
