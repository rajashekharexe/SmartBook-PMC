<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardview"
    android:background="@drawable/edit_bg_custom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="2dp"
    android:layout_marginRight="5dp"
    android:layout_marginBottom="2dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    app:contentPadding="10dp">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/phonedail"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/profile_image"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                android:id="@+id/tv_textview_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:id="@+id/tv_textview_display2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/addingdynamicdrafts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toLeftOf="@+id/actions"
            android:layout_toRightOf="@+id/profile_image"/>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/actions"
            android:layout_width="25dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cbSelectFarmer"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
