<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey_text"
                android:id="@+id/tv_edtEventType"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="@dimen/edittext_height"
                android:text="Event"
                android:editable="false"
                android:layout_weight="0.6"
                style="@style/text_hint"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/text_size_12"
                android:gravity="center"
                android:id="@+id/edtEventType"
                android:background="@drawable/card_layout_back"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/edittext_height"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
                android:drawableRight="@drawable/drop"
                android:layout_weight="0.4"
                style="@style/edit_text"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llExpencesType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey_text"
                android:id="@+id/tv_ExpencesType"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="@dimen/edittext_height"
                android:text="@string/attendance_expenceType"
                android:editable="false"
                android:layout_weight="0.6"
                style="@style/text_hint"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/text_size_12"
                android:gravity="center"
                android:id="@+id/edtExpencesType"
                android:background="@drawable/card_layout_back"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/edittext_height"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
                android:drawableRight="@drawable/drop"
                android:layout_weight="0.4"
                style="@style/edit_text"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llExpencesAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey_text"
                android:id="@+id/tv_edtExpenceAmount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="@dimen/edittext_height"
                android:text="@string/attendance_expenceAmount"
                android:editable="false"
                android:layout_weight="0.6"
                style="@style/text_hint"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/text_size_12"
                android:gravity="center"
                android:id="@+id/edtExpenceAmount"
                android:background="@drawable/edit_bg_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/edittext_height"
                android:layout_weight="0.4"
                android:inputType="numberDecimal"
                style="@style/edit_text"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey_text"
                android:id="@+id/tv_edtsubjects"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="@dimen/edittext_height"
                android:text="Subject"
                android:layout_weight="0.6"
                style="@style/text_hint"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/text_size_12"
                android:gravity="center"
                android:id="@+id/edtsubject"
                android:background="@drawable/edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/edittext_height"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
                android:layout_weight="0.4"
                style="@style/edit_text"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey_text"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_img_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/edittext_height"
                android:text="Image"
                android:layout_weight="0.6"
                style="@style/text_hint"/>
            <ImageView
                android:id="@+id/img_preview"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:src="@drawable/ic_camera2"
                android:layout_weight="0.4"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/grey_text"
                android:id="@+id/tv_edtprcomments"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="@dimen/edittext_height"
                android:text="Comments"
                android:layout_weight="0.6"
                style="@style/text_hint"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:gravity="center"
                android:id="@+id/edtprcomments"
                android:background="@drawable/edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/edittext_height"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
                android:layout_weight="0.4"
                style="@style/edit_text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/picturesavecancellayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <Button
                android:textSize="@dimen/text_size_12"
                android:textColor="#ffffff"
                android:id="@+id/btnpicturecancel"
                android:background="@drawable/btn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/pmc_cancel"
                android:layout_weight="0.5"/>
            <Button
                android:textSize="@dimen/text_size_12"
                android:textColor="#ffffff"
                android:id="@+id/btnpicturesave"
                android:background="@drawable/btn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:text="@string/pmc_save"
                android:layout_weight="0.5"/>
            <Button
                android:textSize="@dimen/text_size_12"
                android:textColor="#ffffff"
                android:id="@+id/btnpicturedelete"
                android:background="@drawable/btn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:text="Delete"
                android:layout_weight="0.5"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
