<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/rl_item"
    android:background="@drawable/card_layout_back"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_actions1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_alignParentLeft="true">
        <CheckBox
            android:id="@+id/select_category"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_alignParentRight="true">
        <ImageView
            android:id="@+id/expand_category"
            android:padding="5dp"
            android:clickable="false"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginBottom="2dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/drop_16_gray"/>
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:textSize="12sp"
        android:id="@+id/layout_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintTextColor="@color/black">
        <com.google.android.material.textfield.TextInputEditText
            android:textSize="12sp"
            android:textColor="@color/black"
            android:gravity="start"
            android:id="@+id/tv_category"
            android:background="@null"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:editable="false"/>
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/tv_selectedIDs"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="start"
        android:id="@+id/tv_filter_applied"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="35dp"
        android:layout_marginLeft="20dp"
        android:text="FiltersApplied"
        android:layout_toLeftOf="@+id/ll_actions"/>
    <View
        android:background="@color/grey"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/tv_category"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_list_of_categories_items"
        android:background="@color/white"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tv_category"/>
    <View
        android:id="@+id/devider"
        android:background="@color/gray3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/rv_list_of_categories_items"/>
    <Button
        android:textColor="@color/white"
        android:id="@+id/btnFilter"
        android:background="@drawable/btn_selection"
        android:paddingLeft="50dp"
        android:paddingTop="10dp"
        android:paddingRight="50dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apply_filter"
        android:layout_below="@+id/devider"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
