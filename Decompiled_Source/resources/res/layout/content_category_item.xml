<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:weightSum="2">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivThumbnail1"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:scaleType="fitXY"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivDelete"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_margin="10dp"
                android:src="0x7f080135"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/action_play"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="0x7f08016c"
                android:tint="@color/red"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/tvDes"
            android:background="@color/gray3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/colorPrimary"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvCropTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/crop"
                    android:layout_weight="0.4"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvCropName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:lines="1"
                    android:layout_weight="0.6"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvBrandTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/brand"
                    android:layout_weight="0.4"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvBrandName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:lines="1"
                    android:layout_weight="0.6"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_weight="0.4"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvTypename"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_weight="0.6"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llRightView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivThumbnail2"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:scaleType="fitXY"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivDelete2"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_margin="10dp"
                android:src="0x7f080135"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/action_play2"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="0x7f08016c"
                android:tint="@color/red"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/tvDes2"
            android:background="@color/gray3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/colorPrimary"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvCropTitle2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/crop"
                    android:layout_weight="0.4"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvCropName2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:lines="1"
                    android:layout_weight="0.6"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvBrandTile2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/brand"
                    android:layout_weight="0.4"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvBrandName2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:lines="1"
                    android:layout_weight="0.6"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvType2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_weight="0.4"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tvTypeName2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_weight="0.6"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
