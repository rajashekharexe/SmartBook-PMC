<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="4">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/vpBanner"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvBanner"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="No Banners."
            android:layout_weight="1.4"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/SliderDots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recenty_published"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recently_published_promotions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3"/>
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recenty_viewed"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recently_viewd_promotions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rv_list_of_promotions">
        <TextView
            android:textSize="20sp"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/txtEmptyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_promotions_available"/>
    </LinearLayout>
</RelativeLayout>
