<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/AppTheme.AppBarOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/AppTheme.PopupOverlay"/>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.conceptglobal.pmc.utils.Itext
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey_text"
                    android:id="@+id/tv_edtEventType"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="Test Video Capture"
                    android:editable="false"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:textSize="@dimen/text_size_12"
                    android:gravity="center"
                    android:id="@+id/edtEventType"
                    android:background="@drawable/card_layout_back"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
                    android:drawableRight="@drawable/drop"
                    android:layout_weight="0.4"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1">
                <com.conceptglobal.pmc.utils.Itext
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:text="Coose Existing file"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <Button
                    android:textColor="@color/grey_text"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/btnSlectAndCompress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select File"
                    android:layout_weight="0.4"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.conceptglobal.pmc.utils.Itext
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey_text"
                    android:id="@+id/tv_edtsubjects"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="Subject"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:textSize="@dimen/text_size_12"
                    android:gravity="center"
                    android:id="@+id/edtsubject"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
                    android:layout_weight="0.4"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.conceptglobal.pmc.utils.Itext
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey_text"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_img_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:text="video"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_preview"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_video"
                    android:layout_weight="0.4"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.conceptglobal.pmc.utils.Itext
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/grey_text"
                    android:id="@+id/tv_edtprcomments"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="Comments"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:gravity="center"
                    android:id="@+id/edtprcomments"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
                    android:layout_weight="0.4"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/picturesavecancellayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <Button
                    android:textColor="#ffffff"
                    android:id="@+id/btnpicturecancel"
                    android:background="@drawable/btn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="cancel"
                    android:layout_weight="0.5"/>
                <Button
                    android:textColor="#ffffff"
                    android:id="@+id/btnpicturesave"
                    android:background="@drawable/btn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:text="Save"
                    android:layout_weight="0.5"/>
                <Button
                    android:textColor="#ffffff"
                    android:id="@+id/btnpicturedelete"
                    android:background="@drawable/btn"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="10dp"
                    android:text="Delete"
                    android:layout_weight="0.5"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:weightSum="2">
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="New Vedio"
                android:layout_weight="1"/>
            <Button
                android:gravity="center"
                android:id="@+id/btnCaptureVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Capture Vedio"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ProgressBar
            android:id="@+id/progressBar"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/btnCompressVideo"
            android:layout_centerHorizontal="true"/>
    </LinearLayout>
</LinearLayout>
