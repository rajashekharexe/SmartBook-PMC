<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cropLL"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:weightSum="3">
        <com.conceptglobal.pmc.utils.Itext
            android:textSize="12sp"
            android:textColor="@color/blue_gray"
            android:gravity="center_horizontal"
            android:id="@+id/textview_crop_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crop Name"
            android:singleLine="true"
            android:layout_weight="1"/>
        <com.conceptglobal.pmc.utils.Iedit
            android:gravity="center_horizontal"
            android:id="@+id/et_old_values"
            android:background="@drawable/edittext_small"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="25dp"
            android:layout_weight="1"
            style="@style/edit_text"/>
        <com.conceptglobal.pmc.utils.Iedit
            android:gravity="center_horizontal"
            android:id="@+id/et_new_values"
            android:background="@drawable/edittext_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="25dp"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            style="@style/edit_text"/>
    </LinearLayout>
</LinearLayout>
