<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:fitsSystemWindows="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llmainpopup"
            android:background="@drawable/card_layout_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/llCustomPopup"
                android:background="@color/colorPrimaryQuarter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:layout_gravity="right"
                    android:id="@+id/buttonDoneMulti"
                    android:background="@drawable/check"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginRight="5dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <Button
                    android:layout_gravity="left"
                    android:id="@+id/buttonReset"
                    android:background="@drawable/window_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
                <com.conceptglobal.pmc.utils.Itext
                    android:textSize="@dimen/heading_size"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/tvCustomPopuphead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:layout_toLeftOf="@+id/buttonDoneMulti"
                    android:layout_toRightOf="@+id/buttonReset"
                    android:layout_centerVertical="true"
                    style="@style/texttypefacenormal"/>
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.conceptglobal.pmc.utils.Iedit
                    android:layout_gravity="center_vertical"
                    android:id="@+id/et_search_list"
                    android:padding="8dp"
                    android:descendantFocusability="beforeDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_margin="10dp"
                    android:hint="Search here"
                    android:ems="10"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llCustomPopupbody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
