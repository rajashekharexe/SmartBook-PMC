<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">
            <ProgressBar
                android:id="@+id/progressspinner"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?android:attr/progressBarStyle"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:layout_gravity="center"
                android:id="@+id/msgtxt"
                android:paddingTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="Sync is happening, please wait..."
                style="@style/texttypefacenormal"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/progressbarll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <ProgressBar
                android:id="@+id/progressbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:indeterminate="true"
                style="?android:attr/progressBarStyleHorizontal"/>
            <RelativeLayout
                android:gravity="center_horizontal"
                android:id="@+id/countRL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:id="@+id/progresscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/texttypefacenormal"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/percentRL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textStyle="bold"
                    android:id="@+id/percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:layout_alignParentLeft="true"
                    style="@style/texttypefacenormal"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:id="@+id/fullpercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/100"
                    android:layout_alignParentRight="true"
                    style="@style/texttypefacenormal"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cancelll"
        android:background="@color/gray3"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="-20dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="-20dp">
        <View
            android:background="@color/gray2"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <Button
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/cancelbtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
