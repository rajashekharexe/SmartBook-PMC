<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/oprattributesRetailerCompany_LL_main"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="7dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_boarder">
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="12sp"
                android:textColor="@color/blue_gray"
                android:ellipsize="marquee"
                android:gravity="center_horizontal"
                android:id="@+id/tv_allsalesvalues"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fadingEdge="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pmc_sales_message"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/colorPrimaryQuarter"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="3dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/btn_add_company_dealer_sales"
                    android:padding="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/pmc_add_company"
                    android:drawableRight="@drawable/ic_menu_btn_add"/>
            </LinearLayout>
            <ListView
                android:id="@+id/lv_companies_dealer_sales"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="3dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
