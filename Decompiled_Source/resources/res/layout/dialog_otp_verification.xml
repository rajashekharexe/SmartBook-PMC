<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTop"
        android:background="@color/ash_dark_two"
        android:padding="@dimen/padding_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivClose"
            android:padding="@dimen/padding_2"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_close_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold"
            android:textColor="@color/slate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verification Code"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lytFarmerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clTop">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:weightSum="2">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/slate"
                android:id="@+id/tvFarmernameLable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farmer Name: "
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/slate"
                android:id="@+id/tvFarmerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_10"
                android:text=""
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_10"
            android:weightSum="2">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/slate"
                android:id="@+id/tvFarmerMobileLable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile: "
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/slate"
                android:id="@+id/tvFarmerMobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_10"
                android:text=""
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/slate"
        android:id="@+id/tvEnterOTP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_15"
        android:text="Enter Verification Code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lytFarmerName"/>
    <EditText
        android:textSize="@dimen/text_size_14"
        android:id="@+id/edtOTP"
        android:background="@drawable/card_layout_back"
        android:padding="@dimen/padding_5"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:maxLines="1"
        android:maxLength="6"
        android:inputType="numberPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvEnterOTP"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/slate"
        android:id="@+id/tvResendOTP"
        android:padding="@dimen/padding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10"
        android:text="@string/resend_otp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtOTP"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingBottom="@dimen/margin_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvResendOTP">
        <com.conceptglobal.pmc.utils.Ibutton
            android:textColor="@color/white"
            android:id="@+id/tvVerifyLater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_15"
            android:text="Verify Later"
            style="@style/btnStyleBreakerBay"/>
        <com.conceptglobal.pmc.utils.Ibutton
            android:textColor="@color/white"
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit"
            style="@style/btnStyleBreakerBay"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
