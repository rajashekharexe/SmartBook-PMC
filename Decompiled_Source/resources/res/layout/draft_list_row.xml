<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardview"
    android:background="@drawable/card_border_custom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="2dp"
    android:layout_marginRight="5dp"
    android:layout_marginBottom="2dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardUseCompatPadding="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tvUnverifiedLabel"
            android:background="@color/red_home"
            android:padding="@dimen/padding_5"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="@string/unverified"
            android:layout_alignParentLeft="true"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/tvUnverifiedLabel"
            android:layout_centerInParent="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/actions"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/profile_image"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginLeft="@dimen/margin_10"
                    android:src="@drawable/phonedail"
                    android:layout_alignParentLeft="true"
                    android:layout_centerInParent="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_toRightOf="@+id/profile_image"
                    android:layout_centerInParent="true">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:id="@+id/tv_textview_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/profile_image"
                        android:layout_alignParentTop="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_12"
                        android:id="@+id/tv_textview_display2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tv_textview_verify"
                    android:background="@color/red"
                    android:padding="@dimen/padding_5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="@dimen/margin_15"
                    android:text="Verify"
                    android:layout_alignParentRight="true"
                    android:layout_centerInParent="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/addingdynamicdrafts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_toRightOf="@+id/profile_image"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/actions"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true">
                <ImageView
                    android:gravity="top"
                    android:id="@+id/phonedail"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/phonedail"/>
                <ImageView
                    android:gravity="center"
                    android:id="@+id/sms"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/sms"
                    android:layout_below="@+id/phonedail"/>
                <ImageView
                    android:id="@+id/deleteRecord"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/delete"
                    android:layout_below="@+id/sms"
                    android:layout_alignParentBottom="true"/>
                <ImageView
                    android:id="@+id/latlongs"
                    android:visibility="gone"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/map"
                    android:layout_below="@+id/sms"/>
                <ImageView
                    android:id="@+id/verifyWithOTP"
                    android:visibility="gone"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/ic_lock"
                    android:layout_below="@+id/latlongs"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
