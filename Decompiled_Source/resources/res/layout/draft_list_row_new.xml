<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardview"
    android:background="@drawable/card_border_custom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="2dp"
    android:layout_marginRight="5dp"
    android:layout_marginBottom="2dp"
    card_view:cardBackgroundColor="@android:color/white"
    card_view:cardUseCompatPadding="true">
    <RelativeLayout
        android:background="@drawable/card_border_custom"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/rlBorderView"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/right_layout"
                    android:background="#80005a96"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:text="R\10O\10P"
                    android:layout_alignTop="@+id/content_view"
                    android:layout_alignBottom="@+id/content_view"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tvUnverifiedLabel"
                    android:background="@color/red_home"
                    android:padding="@dimen/padding_5"
                    android:visibility="gone"
                    android:layout_width="22dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unverified"
                    android:layout_alignParentLeft="true"/>
                <RelativeLayout
                    android:orientation="horizontal"
                    android:id="@+id/content_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_toRightOf="@+id/right_layout">
                    <ImageView
                        android:id="@+id/ivHNF"
                        android:clickable="false"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="-2dp"
                        android:src="@drawable/hero"
                        android:layout_alignParentRight="true"/>
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:id="@+id/rlContent"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/profile_image"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/phonedail"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_toRightOf="@+id/profile_image"
                            android:layout_centerInParent="true">
                            <TextView
                                android:textSize="@dimen/text_size_14"
                                android:textStyle="bold"
                                android:id="@+id/tv_textview_display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="2dp"/>
                            <TextView
                                android:textSize="@dimen/text_size_12"
                                android:id="@+id/tv_textview_display2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:id="@+id/tv_textview_verify"
                            android:background="@color/red"
                            android:paddingLeft="10dp"
                            android:paddingTop="5dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="5dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="5dp"
                            android:text="Verify"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentRight="true"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/addingdynamicdrafts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_toRightOf="@+id/profile_image"/>
                        <ImageView
                            android:id="@+id/ivFavourite"
                            android:visibility="visible"
                            android:layout_width="50dp"
                            android:layout_height="40dp"
                            android:layout_marginRight="10dp"
                            android:src="@drawable/btn_star_big_off"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentRight="true"/>
                        <ImageView
                            android:id="@+id/ivRaisingstar"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:src="@drawable/alert"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentRight="true"/>
                        <ImageView
                            android:id="@+id/deleteRecord"
                            android:visibility="gone"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginTop="15dp"
                            android:src="@drawable/delete"
                            android:layout_below="@+id/ivFavourite"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentBottom="true"/>
                    </RelativeLayout>
                    <View
                        android:id="@+id/devider"
                        android:background="@color/devider_color"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_below="@+id/rlContent"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/llbottomView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="2"
                        android:layout_below="@+id/devider">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/wallent_ll"
                            android:padding="10dp"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/lloutstand"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:weightSum="2">
                                <TextView
                                    android:textSize="12sp"
                                    android:gravity="left"
                                    android:id="@+id/tvLable1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/outstanding"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/colorAccent"
                                    android:gravity="left"
                                    android:id="@+id/tvValue1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"/>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/llbalance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:weightSum="2">
                                <TextView
                                    android:textSize="12sp"
                                    android:gravity="left"
                                    android:id="@+id/tvLable2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/balance_points"
                                    android:layout_weight="1.2"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/colorAccent"
                                    android:gravity="left"
                                    android:id="@+id/tvValue2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_weight="0.8"/>
                            </LinearLayout>
                        </LinearLayout>
                        <View
                            android:id="@+id/devider2"
                            android:background="@color/devider_color"
                            android:layout_width="0.5dp"
                            android:layout_height="match_parent"
                            android:layout_below="@+id/rlContent"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/actions"
                            android:padding="10dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:weightSum="4"
                            android:layout_weight="1">
                            <ImageView
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/iv_web"
                                android:padding="2dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_rtl_web"
                                android:layout_weight="1"/>
                            <ImageView
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/phonedail"
                                android:padding="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_phone"
                                android:layout_weight="1"/>
                            <ImageView
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/sms"
                                android:padding="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_chat_bubble"
                                android:layout_weight="1"/>
                            <ImageView
                                android:id="@+id/verifyWithOTP"
                                android:visibility="gone"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_marginTop="15dp"
                                android:src="@drawable/ic_lock"
                                android:layout_below="@+id/latlongs"
                                android:layout_alignParentBottom="true"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/latlongs"
                                android:padding="2dp"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_gps"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_fellowdetails"
                            android:padding="10dp"
                            android:visibility="visible"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/ll_fellowdetails_bg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:weightSum="2">
                                <TextView
                                    android:textSize="12sp"
                                    android:gravity="center"
                                    android:id="@+id/tvFellowFarmer"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:text="@string/fellow_farmers"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/colorAccent"
                                    android:gravity="center"
                                    android:id="@+id/tvFellowFarmerCount"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
