<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/oprattributesFarmerCrop_LL_main"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="7dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_boarder">
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/colorAccent"
                android:ellipsize="marquee"
                android:gravity="center_horizontal"
                android:id="@+id/tv_allValues"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fadingEdge="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pmc_acers_message"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_owned_farmer_acreage"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_registration_name"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_owned_farmer_acreage"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_leasedin_farmer_acreage"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_registration_name"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_leasedin_farmer_acreage"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_leasedout_farmer_acreage"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_registration_name"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_leasedout_farmer_acreage"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_cultivated_farmer_acreage"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_registration_name"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_cultivated_farmer_acreage"
                    android:background="@drawable/edt_disable"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:editable="false"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text_disable"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_land_holding_farmer_acreage"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_heading_landholding"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_land_holding_farmer_acreage"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:layout_weight="0.4"
                    android:inputType="numberDecimal"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/colorPrimaryQuarter"
                android:layout_width="match_parent"
                android:layout_height="@dimen/add_crop_view_height"
                android:layout_marginTop="3dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/btn_add_crop_farmer_acreage"
                    android:padding="@dimen/padding_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/pmc_add_crop"
                    android:drawableRight="@drawable/ic_menu_btn_add"/>
            </LinearLayout>
            <ListView
                android:id="@+id/lv_crops_farmer_acreage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="3dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
