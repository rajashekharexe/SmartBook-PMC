<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/oprattributesFarmerLand_LL_main"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="7dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_boarder">
        <com.conceptglobal.pmc.utils.Itext
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/colorAccent"
            android:ellipsize="marquee"
            android:gravity="center_horizontal"
            android:id="@+id/tv_allValues"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone"
            android:fadingEdge="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pmc_acers_message"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/colorPrimaryQuarter"
            android:layout_width="match_parent"
            android:layout_height="@dimen/add_crop_view_height"
            android:layout_marginTop="3dp">
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="#ffffff"
                android:gravity="center_vertical"
                android:id="@+id/btn_add_land_farmer"
                android:padding="@dimen/padding_5"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/pmc_add_land"
                android:drawableRight="@drawable/ic_menu_btn_add"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
    </LinearLayout>
</LinearLayout>
