<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_boarder">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:gravity="right"
                    android:layout_gravity="right"
                    android:orientation="horizontal"
                    android:id="@+id/ll_latlong_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="0.4"
                    style="@style/edit_text_disable">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/edt_disable"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        style="@style/edit_text_disable">
                        <com.conceptglobal.pmc.utils.Itext
                            android:id="@+id/tv_latitude_personal_detailss"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:hint="@string/pmc_label_latitude"
                            android:layout_weight="0.5"/>
                        <com.conceptglobal.pmc.utils.Itext
                            android:id="@+id/tv_longitude_personal_detailss"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:hint="@string/pmc_label_longitude"
                            android:layout_weight="0.5"/>
                    </LinearLayout>
                    <ImageView
                        android:textColor="@color/white"
                        android:id="@+id/btn_get_latlong_farmer_personal_detailss"
                        android:background="@color/colorPrimaryQuarter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/geo"
                        android:text="@string/pmc_label_get"
                        android:layout_weight="0.7"
                        style="@style/btnStyleBreakerBay"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:gravity="center_horizontal"
                android:id="@+id/imageViewPicture"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/cam"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llactAddress"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:textSize="@dimen/text_size_12"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="Activity \10 Address"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_address"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:lines="6"
                    android:layout_weight="0.4"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <com.conceptglobal.pmc.utils.Itext
                    android:id="@+id/tv_farmer_farmer_other_details"
                    android:background="@color/action_green"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_registration_name"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/black"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/tv_bayerfarmer_other_details"
                    android:background="@drawable/edt_disable"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="0.4"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_dealer_farmer_other_details"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_registration_name"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Itext
                    android:gravity="center_vertical"
                    android:id="@+id/tv_retailers_farmer_other_details"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/select_dealer_hint"
                    android:layout_weight="0.4"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:textSize="@dimen/text_size_12"
                    android:id="@+id/tv_discription_farmer_other_details"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_registration_name"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <EditText
                    android:textSize="@dimen/text_size_12"
                    android:id="@+id/et_discription_farmer_other_details"
                    android:background="@drawable/edit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:lines="6"
                    android:maxLength="200"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890 /,-#"
                    android:layout_weight="0.4"
                    android:inputType="textMultiLine"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:textSize="@dimen/text_size_12"
                    android:id="@+id/btnSelectCustomer"
                    android:background="@drawable/btn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="Select Farmer"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Itext
                    android:textSize="@dimen/text_size_12"
                    android:gravity="center_vertical"
                    android:id="@+id/txtSelectCustomer"
                    android:background="@drawable/edit"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="0.4"
                    style="@style/edit_text"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:textSize="@dimen/text_size_12"
                    android:id="@+id/btnSelectTerritory"
                    android:background="@drawable/btn"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="Select Territory"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Itext
                    android:textSize="@dimen/text_size_12"
                    android:gravity="center_vertical"
                    android:id="@+id/txtSelectTerritory"
                    android:background="@drawable/edit"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="0.4"
                    style="@style/edit_text"/>
            </LinearLayout>
            <TextView
                android:id="@+id/pictures"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pictures"/>
            <GridView
                android:gravity="center"
                android:id="@+id/grid_view_farmer"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:horizontalSpacing="1dp"
                android:verticalSpacing="10dp"
                android:stretchMode="columnWidth"
                android:columnWidth="150dp"
                android:numColumns="5"
                android:isScrollContainer="false"/>
            <TextView
                android:id="@+id/videos"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Videos"/>
            <GridView
                android:gravity="center"
                android:id="@+id/grid_view_farmer_copy2"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:horizontalSpacing="1dp"
                android:verticalSpacing="10dp"
                android:stretchMode="columnWidth"
                android:columnWidth="150dp"
                android:numColumns="5"
                android:isScrollContainer="false"/>
            <LinearLayout
                android:gravity="right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.conceptglobal.imaterialdesign.widget.FloatingActionButton
                    android:layout_gravity="end|bottom"
                    android:id="@+id/fab2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/fab_margin"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    app:fab_iconSrc="@drawable/videoplayicon"
                    app:v_styleId="@array/fab_icon"/>
                <com.conceptglobal.imaterialdesign.widget.FloatingActionButton
                    android:layout_gravity="end|bottom"
                    android:id="@+id/fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/fab_margin"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    app:fab_iconSrc="@drawable/camera_img"
                    app:v_styleId="@array/fab_icon"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="right"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/white"
                    android:id="@+id/btn_inactive_farmer_other_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="DisCard"
                    style="@style/btnStyleBreakerBay"/>
                <com.conceptglobal.pmc.utils.Ibutton
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/white"
                    android:id="@+id/btn_save_farmer_other_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    style="@style/btnStyleBreakerBay"/>
                <com.conceptglobal.pmc.utils.Ibutton
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/white"
                    android:id="@+id/btn_visit_farmer_other_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="5dp"
                    android:text="Button"
                    android:marqueeRepeatLimit="3"
                    style="@style/btnStyleBreakerBay"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
