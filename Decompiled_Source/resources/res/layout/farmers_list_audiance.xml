<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/filters"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2">
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/ed_CropSearch"
                android:background="@drawable/edt_disable"
                android:paddingLeft="10dp"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_margin="2dp"
                android:layout_marginTop="2dp"
                android:hint="Crop"
                android:drawableRight="@drawable/drop_16"
                android:layout_weight="1"
                style="@style/edit_text_disable"/>
            <TextView
                android:id="@+id/tvCropId"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/ed_stateSearch"
                android:background="@drawable/edt_disable"
                android:paddingLeft="10dp"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_margin="2dp"
                android:layout_marginTop="2dp"
                android:hint="State"
                android:drawableRight="@drawable/drop_16"
                android:layout_weight="1"
                style="@style/edit_text_disable"/>
            <TextView
                android:id="@+id/tvStateId"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2">
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/ed_districtSearch"
                android:background="@drawable/edt_disable"
                android:paddingLeft="10dp"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_margin="2dp"
                android:layout_marginTop="2dp"
                android:hint="District"
                android:drawableRight="@drawable/drop_16"
                android:layout_weight="1"
                style="@style/edit_text_disable"/>
            <TextView
                android:id="@+id/tvDistrictId"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/ed_mandalSearch"
                android:background="@drawable/edt_disable"
                android:paddingLeft="10dp"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_margin="2dp"
                android:layout_marginTop="2dp"
                android:hint="Taluka"
                android:drawableRight="@drawable/drop_16"
                android:layout_weight="1"
                style="@style/edit_text_disable"/>
            <TextView
                android:id="@+id/tvMandalId"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2">
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/ed_LocationSearch"
                android:background="@drawable/edt_disable"
                android:paddingLeft="10dp"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_margin="2dp"
                android:layout_marginTop="2dp"
                android:hint="Village"
                android:drawableRight="@drawable/drop_16"
                android:layout_weight="1"
                style="@style/edit_text_disable"/>
            <TextView
                android:id="@+id/tvLocationId"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/ed_RadiusSearch"
                android:background="@drawable/edt_disable"
                android:paddingLeft="10dp"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_margin="2dp"
                android:layout_marginTop="2dp"
                android:hint="Radius(kms)"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/normal_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/farmer_lsit_goBtn"
                android:paddingLeft="20dp"
                android:paddingTop="8dp"
                android:paddingRight="20dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go"
                style="@style/btnStyleBreakerBay"/>
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/normal_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/farmer_lsit_ClearBtn"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:text="Clear"
                style="@style/btnStyleBreakerBay"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/searchrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:layout_below="@+id/filters">
        <EditText
            android:id="@+id/searchkeyword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search here"
            android:layout_toLeftOf="@+id/btnrl"
            android:layout_alignParentLeft="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/btnrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/clearbtn"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_clear_black_24dp"/>
            <Button
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/searchbtn"
                android:background="@color/colorPrimary"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="Go"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/loaderrl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/searchrl">
        <ProgressBar
            android:id="@+id/progressbar"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <TextView
            android:id="@+id/loadertxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="Loading..."
            android:layout_toRightOf="@+id/progressbar"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/no_data_found_ll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.conceptglobal.pmc.utils.Itext
            android:id="@+id/tv_no_data_found"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:text="@string/pmc_no_data_found"
            style="@style/text_activity_list"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/progressll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tvSelectedFarmerescount"
        android:background="@color/colorPrimary"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/filters"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:paddingBottom="60dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_above="@+id/btn_submit"
        android:layout_below="@+id/tvSelectedFarmerescount"/>
    <com.conceptglobal.ifastscroll.FastScroller
        android:orientation="vertical"
        android:id="@+id/fastscroll"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_above="@+id/btn_submit"
        android:layout_below="@+id/tvSelectedFarmerescount"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"/>
    <Button
        android:id="@+id/btn_submit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ok"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/btnStyleBreakerBay"/>
</RelativeLayout>
