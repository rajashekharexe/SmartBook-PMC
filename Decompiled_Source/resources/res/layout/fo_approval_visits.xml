<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_sync_screen"
    android:background="@color/background_color"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/searchLL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <LinearLayout
            android:gravity="left"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.75">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/edittext_height"
                android:text="@string/pmcmarket"
                style="@style/text_hint"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="@dimen/edittext_height"
                android:text="@string/pmcfo"
                style="@style/text_hint"/>
            <TextView
                android:id="@+id/textViewMarketNameID"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.25">
            <EditText
                android:id="@+id/editTextMarketName"
                android:background="@drawable/edt_disable2"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:minHeight="@dimen/edittext_height"
                android:hint="@string/select"
                style="@style/edit_text_disable"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="0.3">
                    <EditText
                        android:id="@+id/editTextFoName"
                        android:background="@drawable/edt_disable"
                        android:focusable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/edittext_height"
                        android:hint="@string/select"
                        style="@style/edit_text_disable"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/textViewFoNameID"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="0.7">
                    <Button
                        android:textColor="@color/white"
                        android:id="@+id/buttonGo"
                        android:background="@drawable/custom_btn2"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/edittext_height"
                        android:text="@string/btnGOText"
                        style="@style/button_style"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/approveRL"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="5dp"
        android:baselineAligned="false"
        android:layout_below="@+id/searchLL">
        <LinearLayout
            android:gravity="right"
            android:id="@+id/btnsRL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <Button
                android:textColor="@color/white"
                android:id="@+id/buttonApprove"
                android:background="@drawable/custom_btn2"
                android:paddingLeft="10dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:minHeight="@dimen/edittext_height"
                android:text="@string/btnApproveText"
                style="@style/button_style"/>
            <Button
                android:textColor="@color/white"
                android:id="@+id/buttonReject"
                android:background="@drawable/custom_btn2"
                android:paddingLeft="10dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:minHeight="@dimen/edittext_height"
                android:text="@string/btnRejectText"
                style="@style/button_style"/>
            <Button
                android:textColor="@color/white"
                android:id="@+id/buttonSelectAll"
                android:background="@drawable/custom_btn2"
                android:paddingLeft="10dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:minHeight="@dimen/edittext_height"
                android:text="@string/btnSelectAllText"
                android:singleLine="true"
                style="@style/button_style"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom|right"
            android:id="@+id/focountRL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:textColor="@color/black"
                android:gravity="right"
                android:id="@+id/textViewFarmerCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text="FC: 10"
                android:singleLine="true"
                style="@style/text_hint"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lvlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/approveRL">
        <ListView
            android:id="@+id/listViewSelectFarmers"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:dividerHeight="5dp"/>
    </LinearLayout>
</RelativeLayout>
