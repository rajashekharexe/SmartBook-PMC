<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/titlerl"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/background_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="Field Track"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/syncData"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_action_refresh"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <ImageView
            android:id="@+id/reports"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="60dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_target"
            android:layout_toLeftOf="@+id/view_dummy"
            android:layout_centerVertical="true"/>
        <View
            android:id="@+id/view_dummy"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignParentRight="true"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pbRefresh"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:indeterminate="true"
            android:progressDrawable="@color/white"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="src_atop"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llContentView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginRight="2dp"
        android:layout_below="@+id/titlerl">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llDistance"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:weightSum="2">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tvApproximateDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Approximate Distance(KM)"
                android:layout_weight="0.7"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@android:color/black"
                android:id="@+id/etDistanceTravelled"
                android:background="@drawable/card_layout_back"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Travel Distance"
                android:maxLength="4"
                android:layout_weight="1.3"
                android:inputType="number"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:weightSum="2">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Start Time"
                android:layout_weight="0.7"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@android:color/black"
                android:id="@+id/tvStartTime"
                android:background="@drawable/card_layout_back_desable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="2dp"
            android:weightSum="2">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="End Time"
                android:layout_weight="0.7"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@android:color/black"
                android:id="@+id/tvEndTime"
                android:background="@drawable/card_layout_back_desable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="2dp"
            android:weightSum="2">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Duration(Hrs)"
                android:layout_weight="0.7"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@android:color/black"
                android:id="@+id/tvDuration"
                android:background="@drawable/card_layout_back_desable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llRegularexp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:weightSum="2"
        android:layout_below="@+id/llContentView">
        <TextView
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Regularize"
            android:layout_weight="0.7"/>
        <CheckBox
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/cbRegularige"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginLeft="20dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llContentView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/llRegularexp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llActualEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="2dp"
            android:weightSum="2">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tvActualEndTime"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Actual End Time"
                android:layout_weight="0.7"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@android:color/black"
                android:id="@+id/etActualEndDate"
                android:background="@drawable/card_layout_back"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Travel Distance"
                android:layout_weight="1.3"
                android:inputType="number"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="4dp"
            android:weightSum="2">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tvDescriptionMain"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Description "
                android:layout_weight="0.7"/>
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@android:color/black"
                android:id="@+id/etDescription"
                android:background="@drawable/card_layout_back"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Reason"
                android:drawableRight="@drawable/drop_16"
                android:layout_weight="1.3"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:textSize="20dp"
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/startday"
        android:background="@drawable/btn"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Start-Day"
        android:layout_below="@+id/llContentView2"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:id="@+id/startstop"
        android:visibility="invisible"
        android:layout_width="160dp"
        android:layout_height="37dp"
        android:layout_marginRight="48dp"
        android:layout_alignBottom="@+id/startday"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="48dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:id="@+id/ll_PIPContent"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/startday"
        android:layout_centerHorizontal="true">
        <TextView
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</RelativeLayout>
