<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <com.conceptglobal.pmc.utils.Ibutton
            android:textSize="@dimen/text_size_12"
            android:id="@+id/tv_discription_farmer_other_details_fbf_resolution"
            android:background="@drawable/btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="@dimen/edittext_height"
            android:text="@string/pmc_resolution_remarks"
            android:layout_weight="0.6"
            style="@style/text_hint"/>
        <EditText
            android:textSize="@dimen/text_size_12"
            android:id="@+id/et_discription_farmer_other_details_fbff_resolution"
            android:background="@drawable/edit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:lines="6"
            android:maxLength="200"
            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890 /,-#"
            android:layout_weight="0.4"
            android:inputType="textMultiLine"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/pmc_resolved_status"
            android:layout_weight="1"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/txt_resolvedStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/pmc_resolved_status"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/pmc_reslouton_send_sms"
            android:layout_weight="0.8"/>
        <CheckBox
            android:gravity="center_vertical"
            android:id="@+id/checkbox_sms_reportee"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1.2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/pmc_resolution_send_sms_to_executor"
            android:layout_weight="0.8"/>
        <CheckBox
            android:gravity="center_vertical"
            android:id="@+id/checkbox_sms_exicutor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:checked="true"
            android:layout_weight="1.2"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <com.conceptglobal.pmc.utils.Ibutton
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/btn_visit_farmer_other_details_fbf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="5dp"
            android:text="Resolve"
            android:marqueeRepeatLimit="3"
            style="@style/btnStyleBreakerBay"/>
    </LinearLayout>
</LinearLayout>
