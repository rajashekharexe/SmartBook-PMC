<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/tab2"
            android:background="@color/background_color"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btn_addExpense">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/filtersTODOList"
                android:background="@color/transparent"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2">
                    <com.conceptglobal.pmc.utils.Iedit
                        android:textSize="@dimen/normal_text_size"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:gravity="center"
                        android:id="@+id/ed_custType"
                        android:background="@drawable/edt_disable"
                        android:paddingLeft="10dp"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_margin="2dp"
                        android:layout_marginTop="2dp"
                        android:hint="Customer Type"
                        android:drawableRight="@drawable/drop"
                        android:layout_weight="1"
                        style="@style/edit_text_disable"/>
                    <TextView
                        android:id="@+id/tvCustTypeId"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                    <com.conceptglobal.pmc.utils.Iedit
                        android:textSize="@dimen/normal_text_size"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:gravity="center"
                        android:id="@+id/ed_crop"
                        android:background="@drawable/edt_disable"
                        android:paddingLeft="10dp"
                        android:focusable="false"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_margin="2dp"
                        android:layout_marginTop="2dp"
                        android:hint="Crop"
                        android:drawableRight="@drawable/drop"
                        android:layout_weight="1"
                        style="@style/edit_text_disable"/>
                    <TextView
                        android:id="@+id/tvCropId"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2">
                    <com.conceptglobal.pmc.utils.Iedit
                        android:textSize="@dimen/normal_text_size"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:gravity="center"
                        android:id="@+id/ed_RadiusSearch"
                        android:background="@drawable/edt_disable"
                        android:paddingLeft="10dp"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_margin="2dp"
                        android:layout_marginTop="2dp"
                        android:hint="Radius(kms)"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"/>
                    <com.conceptglobal.pmc.utils.Iedit
                        android:textSize="@dimen/normal_text_size"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:gravity="center"
                        android:id="@+id/ed_Brand"
                        android:background="@drawable/edt_disable"
                        android:paddingLeft="10dp"
                        android:focusable="false"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_margin="2dp"
                        android:layout_marginTop="2dp"
                        android:hint="Brand"
                        android:layout_weight="1"
                        style="@style/edit_text_disable"/>
                    <TextView
                        android:id="@+id/tvBrandId"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="right"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <com.conceptglobal.pmc.utils.Itext
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/filter_list_goBtn"
                        android:paddingLeft="20dp"
                        android:paddingTop="8dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Go"
                        style="@style/btnStyleBreakerBay"/>
                    <com.conceptglobal.pmc.utils.Itext
                        android:textSize="@dimen/normal_text_size"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/filter_list_ClearBtn"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"
                        android:text="Clear"
                        style="@style/btnStyleBreakerBay"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lv_listRecycle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <com.conceptglobal.pmc.utils.Ibutton
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/btn_addExpense"
            android:paddingLeft="5sp"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginRight="50dp"
            android:text="Submit"
            android:layout_alignParentBottom="true"
            android:foregroundGravity="center_horizontal"
            style="@style/btnStyleBreakerBay"/>
    </RelativeLayout>
</FrameLayout>
