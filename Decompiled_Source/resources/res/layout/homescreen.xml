<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:paddingLeft="10dp"
    android:paddingTop="50dp"
    android:paddingRight="10dp"
    android:paddingBottom="50dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_dark"
                    android:layout_gravity="center"
                    android:id="@+id/ivwork"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="150dp"
                    android:text="WORK"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_dark"
                    android:gravity="center"
                    android:id="@+id/ivassign"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:minHeight="150dp"
                    android:text="ASSIGN"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <Button
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_dark"
                    android:gravity="center"
                    android:id="@+id/ivapprove"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="150dp"
                    android:text="APPROVE"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_dark"
                    android:gravity="center"
                    android:id="@+id/ivstatus"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:minHeight="150dp"
                    android:text="STATUS"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <Button
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_dark"
                    android:gravity="center"
                    android:id="@+id/addfarmer"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="150dp"
                    android:text="ADD FARMER"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_dark"
                    android:gravity="center"
                    android:id="@+id/addretailer"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:minHeight="150dp"
                    android:text="ADD RETAILER"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <Button
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_dark"
                    android:gravity="center"
                    android:id="@+id/addvillage"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="150dp"
                    android:text="ADD VILLAGE"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
