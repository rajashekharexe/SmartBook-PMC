<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/cardView"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="5dp"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="?android:attr/selectableItemBackground"
        android:padding="0dp"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">
        <com.conceptglobal.pmc.utils.CircleImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_cropThumbnail"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="0x7f080064"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/iv_cropThumbnail">
            <TextView
                android:textSize="14sp"
                android:textColor="#707070"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_cropName"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sample title"
                android:lines="1"
                android:layout_toLeftOf="@+id/ivDownload"/>
            <ImageView
                android:id="@+id/ivDownload"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_alignTop="@+id/tv_cropName"
                android:layout_alignBottom="@+id/tv_cropName"
                android:layout_alignParentRight="true"
                android:foregroundGravity="center"/>
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/crop_progress"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
