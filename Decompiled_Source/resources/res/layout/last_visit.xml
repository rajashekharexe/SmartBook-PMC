<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:id="@+id/tv_title_visit_date_last_visit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/text_dark_blue"
                android:id="@+id/tv_visit_date_last_visit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/text_noraml"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:id="@+id/tv_title_activity_last_visit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bharath Kumar Bachina iconcept software services pvt.ltd"
                android:layout_weight="1"/>
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/text_dark_blue"
                android:id="@+id/tv_activity_last_visit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/text_noraml"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:id="@+id/tv_title_crop_last_visit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/text_dark_blue"
                android:id="@+id/tv_crop_last_visit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/text_noraml"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:id="@+id/tv_title_brand_last_visit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/text_dark_blue"
                android:id="@+id/tv_brand_last_visit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/text_noraml"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:id="@+id/tv_title_discription_last_visit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/text_dark_blue"
                android:id="@+id/et_discription_last_visit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="false"
                android:layout_weight="1"
                style="@style/text_noraml"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
