<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:id="@+id/webView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnViewHistory"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_list_alert"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnViewHistory">
        <com.conceptglobal.pmc.utils.Itext
            android:id="@+id/tv_list_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:text="@string/pmc_no_data_found"
            style="@style/text_activity_list"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/svLastVisitData"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnViewHistory">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llLastvisitBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">
            <ListView
                android:id="@+id/lv_list_alert"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:dividerHeight="0dp"/>
        </LinearLayout>
    </ScrollView>
    <Button
        android:id="@+id/btnViewHistory"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableRight="@drawable/ic_history"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        style="@style/btnStyleBreakerBay"/>
</RelativeLayout>
