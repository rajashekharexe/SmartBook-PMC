<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbarStyle="outsideOverlay"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_logo"
        android:background="@drawable/deepak_login_logo"
        android:visibility="visible"
        android:layout_width="@dimen/logo_width"
        android:layout_height="@dimen/logo_height"
        android:layout_marginLeft="-10dp"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/toolbar"
        android:layout_centerHorizontal="true"/>
    <com.conceptglobal.imaterialdesign.widget.TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/heading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name2"
        android:layout_below="@+id/iv_logo"
        style="@style/text_subdetails"/>
    <com.conceptglobal.imaterialdesign.widget.TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/heading2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name3"
        android:layout_below="@+id/heading"
        style="@style/text_subdetails"/>
    <com.conceptglobal.imaterialdesign.widget.TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_fo_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/fo_name"
        android:layout_below="@+id/heading2"
        style="@style/text_noraml"/>
    <com.conceptglobal.imaterialdesign.widget.TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_pdaid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Employee ID:"
        android:layout_below="@+id/tv_fo_name"
        style="@style/text_noraml"/>
    <com.conceptglobal.imaterialdesign.widget.TextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_geoName"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text=""
        android:layout_below="@+id/tv_pdaid"
        style="@style/text_noraml"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:id="@+id/progressBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/tv_geoName">
        <ProgressBar
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/tv_geoName">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp">
            <com.conceptglobal.imaterialdesign.widget.EditText
                android:textColorHint="@color/colorAccent"
                android:id="@+id/et_pin_login"
                android:paddingLeft="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/pmc_login_pin"
                android:drawableLeft="@drawable/ic_action_not_secure"
                android:inputType="numberPassword"
                android:imeOptions="actionDone"
                app:et_inputId="@+id/textfield_et_helper_input"
                app:et_supportMode="helper"
                app:v_styleId="@array/edittext"/>
            <com.conceptglobal.imaterialdesign.widget.EditText
                android:id="@+id/emptyedit"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <com.conceptglobal.imaterialdesign.widget.Button
                android:id="@+id/btn_submit_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pmc_login_submit"
                app:v_styleId="@array/button_raise_wave_color"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp">
                <com.conceptglobal.imaterialdesign.widget.TextView
                    android:gravity="center"
                    android:id="@+id/tv_changeLanguage"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginRight="30dp"
                    android:text="Change language"
                    style="@style/text_sub_details"/>
                <com.conceptglobal.imaterialdesign.widget.TextView
                    android:gravity="center"
                    android:id="@+id/tv_forgot_pwd_login"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="30dp"
                    android:text="@string/pmc_label_forgot_pwd"
                    style="@style/text_sub_details"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.conceptglobal.imaterialdesign.widget.TextView
        android:textSize="10sp"
        android:gravity="center"
        android:id="@+id/tv_copyright_login"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:text="@string/copy_right"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
