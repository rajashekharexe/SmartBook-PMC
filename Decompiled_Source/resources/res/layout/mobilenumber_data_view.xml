<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearlayout_mobile"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <com.conceptglobal.pmc.utils.Itext
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pmc_heading_mobile"
            android:singleLine="true"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:weightSum="2">
        <com.conceptglobal.pmc.utils.Itext
            android:textSize="12sp"
            android:textColor="@color/blue_gray"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pmc_old"
            android:singleLine="true"
            android:layout_weight="1"/>
        <com.conceptglobal.pmc.utils.Iedit
            android:id="@+id/et_mobile_old"
            android:background="@drawable/edit"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:layout_weight="1"
            style="@style/edit_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:weightSum="2">
        <com.conceptglobal.pmc.utils.Itext
            android:textSize="12sp"
            android:textColor="@color/blue_gray"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pmc_new"
            android:singleLine="true"
            android:layout_weight="1"/>
        <com.conceptglobal.pmc.utils.Iedit
            android:id="@+id/et_mobile_new"
            android:background="@drawable/edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:layout_weight="1"
            style="@style/edit_text"/>
    </LinearLayout>
</LinearLayout>
