<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_boarder">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_farmer_type"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_reg_farmer_farmer_type"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_farmer_type"
                    android:background="@drawable/edt_disable"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="Select"
                    android:editable="false"
                    android:layout_weight="0.4"
                    style="@style/edit_text_disable"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_preferred_retailler"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_reg_farmer_prferred_retailer"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_preferred_retailler"
                    android:background="@drawable/edt_disable"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="Select"
                    android:editable="false"
                    android:layout_weight="0.4"
                    style="@style/edit_text_disable"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_social_status"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_reg_farmer_social_status"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_social_status"
                    android:background="@drawable/edt_disable"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="Select"
                    android:editable="false"
                    android:layout_weight="0.4"
                    style="@style/edit_text_disable"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
