<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_boarder">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:gravity="right"
                    android:layout_gravity="right"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="0.4"
                    style="@style/edit_text_disable">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@drawable/edt_disable"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        style="@style/edit_text_disable">
                        <com.conceptglobal.pmc.utils.Itext
                            android:id="@+id/tv_latitude_personal_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:hint="@string/pmc_label_latitude"
                            android:layout_weight="0.5"/>
                        <com.conceptglobal.pmc.utils.Itext
                            android:id="@+id/tv_longitude_personal_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:hint="@string/pmc_label_longitude"
                            android:layout_weight="0.5"/>
                    </LinearLayout>
                    <com.conceptglobal.pmc.utils.Ibutton
                        android:textColor="@color/white"
                        android:id="@+id/btn_get_latlong_farmer_personal_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pmc_label_get"
                        android:layout_weight="0.7"
                        style="@style/btnStyleBreakerBay"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_heading_state"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_heading_state"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_state"
                    android:background="@drawable/edt_disable"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="Select"
                    android:editable="false"
                    android:layout_weight="0.4"
                    style="@style/edit_text_disable"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_heading_district"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_heading_district"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_district"
                    android:background="@drawable/edt_disable"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="Select"
                    android:editable="false"
                    android:layout_weight="0.4"
                    style="@style/edit_text_disable"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_heading_taluka"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_heading_taluka"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_taluka"
                    android:background="@drawable/edt_disable"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="Select"
                    android:editable="false"
                    android:layout_weight="0.4"
                    style="@style/edit_text_disable"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <com.conceptglobal.pmc.utils.Ibutton
                    android:id="@+id/tv_heading_village"
                    android:background="@drawable/btn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/edittext_height"
                    android:text="@string/pmc_heading_village"
                    android:layout_weight="0.6"
                    style="@style/text_hint"/>
                <com.conceptglobal.pmc.utils.Iedit
                    android:id="@+id/et_village"
                    android:background="@drawable/edt_disable"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/edittext_height"
                    android:hint="Select"
                    android:editable="false"
                    android:layout_weight="0.4"
                    style="@style/edit_text_disable"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
