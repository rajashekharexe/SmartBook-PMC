<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/toolbar"/>
    <com.conceptglobal.pmc.utils.RobotoFont
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/app_name2"
        style="@style/text_subdetails"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">
            <com.conceptglobal.pmc.utils.Iedit
                android:id="@+id/et_mobile_registration"
                android:background="@drawable/username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:minHeight="@dimen/edittext_height"
                android:hint="@string/pmc_registered_empid"
                android:drawablePadding="5dp"
                android:layout_weight="1"
                android:inputType="number"
                style="@style/edit_text"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:id="@+id/et_email_registration"
                android:background="@drawable/username"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:minHeight="@dimen/edittext_height"
                android:hint="@string/pmc_registration_email"
                android:drawableLeft="@drawable/ic_email"
                android:drawablePadding="4dp"
                android:layout_weight="1"
                style="@style/edit_text"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:id="@+id/et_imei_registration"
                android:background="@drawable/username"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:minHeight="@dimen/edittext_height"
                android:hint="@string/pmc_registration_imei"
                android:drawableLeft="@drawable/ic_imei"
                android:drawablePadding="5dp"
                android:layout_weight="1"
                android:inputType="number"
                style="@style/edit_text"/>
            <com.conceptglobal.pmc.utils.Ibutton
                android:textColor="@color/white"
                android:id="@+id/btn_submit_registration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pmc_registration_submit"
                style="@style/btnStyleBreakerBay"/>
            <com.conceptglobal.pmc.utils.Itext
                android:gravity="center"
                android:id="@+id/tv_copyright_login"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:text="@string/live"
                style="@style/text_sub_details"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
