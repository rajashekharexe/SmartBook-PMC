<?xml version="1.0" encoding="utf-8"?>
<com.conceptglobal.pmc.views.RippleView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rippleview"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:rv_type="rectangle"
    app:rv_zoom="true">
    <RelativeLayout
        android:id="@+id/contentrl"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.conceptglobal.pmc.utils.CircleImageView
            android:id="@+id/profile_image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_user2"/>
        <TextView
            android:id="@+id/tv_textview_display"
            android:paddingLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="test"
            android:layout_toLeftOf="@+id/arrow_right"
            android:layout_toRightOf="@+id/profile_image"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/arrow_right"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/rightarrow"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/contentrl"/>
</com.conceptglobal.pmc.views.RippleView>
