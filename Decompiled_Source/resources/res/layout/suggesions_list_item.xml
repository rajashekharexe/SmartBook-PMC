<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center"
        android:id="@+id/tvAttrName"
        android:background="@drawable/edit_bg_table"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:minLines="2"
        android:singleLine="false"
        android:layout_alignTop="@+id/tvAttrValue"
        android:layout_alignBottom="@+id/tvAttrValue"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvAttrValue"
        android:background="@drawable/edit_bg_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:singleLine="false"
        android:layout_toRightOf="@+id/tvAttrName"/>
</RelativeLayout>
