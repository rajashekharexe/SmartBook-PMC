<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="2dp"
    android:layout_marginRight="5dp">
    <ImageView
        android:id="@+id/content_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        app:srcCompat="0x7f08015f"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_content_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paddy Harvesting Machine "
        android:layout_toRightOf="@+id/content_type"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/grey"
        android:id="@+id/tv_content_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="It is an engine operated, walk behind type harvester suitable for harvesting"
        android:layout_below="@+id/content_type"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/frame"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/tv_content_desc">
        <TextView
            android:textStyle="bold"
            android:layout_gravity="center"
            android:id="@+id/content"
            android:padding="2dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:15"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/preview_group"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="2dp"
            app:cardElevation="7dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/img_preview_iv"
                    android:padding="5dp"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:layout_toRightOf="@+id/img_preview_iv"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/title_tv"
                    android:layout_alignParentRight="true"
                    app:srcCompat="0x7f080165"/>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/desc_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="3dp"
                    android:layout_toRightOf="@+id/img_preview_iv"
                    android:layout_below="@+id/title_tv"/>
                <TextView
                    android:textSize="10sp"
                    android:id="@+id/site_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_toRightOf="@+id/img_preview_iv"
                    android:layout_below="@+id/desc_tv"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1"
        android:layout_below="@+id/frame">
        <com.conceptglobal.pmc.promotions.utils.FlowLayout
            android:orientation="horizontal"
            android:id="@+id/chipsBoxLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_weight="0.8"
            app:flChildSpacing="5dp"
            app:flChildSpacingForLastRow="align"
            app:flRowSpacing="8dp"/>
    </LinearLayout>
    <View
        android:background="@color/grey"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/llChips"/>
</RelativeLayout>
