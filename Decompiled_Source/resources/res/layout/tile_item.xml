<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardview"
    android:background="@drawable/edit_bg_home"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardUseCompatPadding="true">
    <RelativeLayout
        android:id="@+id/contentr2"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/btnrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_size_20"
                android:textStyle="bold"
                android:textColor="#3e3e3e"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/text_size_20"
                android:text="Add Farmer"
                android:layout_toLeftOf="@+id/btn"
                android:layout_alignParentLeft="true"/>
            <ImageView
                android:id="@+id/btn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:src="@drawable/ic_add_farmer"
                android:layout_alignTop="@+id/title"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/firstdescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/btnrl">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="#3e3e3e"
                android:id="@+id/description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/text_size_20"
                android:text="fsadf"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/text_size_20"
                android:textStyle="bold"
                android:textColor="@color/pi_blue"
                android:id="@+id/count"
                android:paddingLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22"
                android:layout_toRightOf="@+id/description"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/seconddescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/firstdescription"
            android:layout_below="@+id/btnrl"
            android:layout_alignTop="@+id/firstdescription"
            android:layout_alignBottom="@+id/firstdescription"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="#3e3e3e"
                android:id="@+id/description1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="fasdf"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/text_size_20"
                android:textStyle="bold"
                android:textColor="#f22c2c"
                android:id="@+id/count1"
                android:paddingLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="33"
                android:layout_toRightOf="@+id/description1"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/thirddescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/seconddescription"
            android:layout_below="@+id/btnrl"
            android:layout_alignTop="@+id/seconddescription"
            android:layout_alignBottom="@+id/seconddescription">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="#3e3e3e"
                android:id="@+id/description2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="fadsf"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/text_size_20"
                android:textStyle="bold"
                android:textColor="#ff9100"
                android:id="@+id/count2"
                android:paddingLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22"
                android:layout_toRightOf="@+id/description2"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/fourthdescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/firstdescription">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/description4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="fsadf"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/text_size_24"
                android:id="@+id/count4"
                android:paddingLeft="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22"
                android:layout_toRightOf="@+id/description4"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/red_light_bg"
            android:id="@+id/tvalert"
            android:layout_width="50dp"
            android:layout_height="0dp"
            android:layout_marginRight="26dp"
            android:layout_marginBottom="24dp"
            android:text="Use online only"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
