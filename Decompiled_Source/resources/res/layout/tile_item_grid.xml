<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardview"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    app:cardBackgroundColor="@color/home_page_card"
    app:cardCornerRadius="4dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">
    <FrameLayout
        android:background="@drawable/home_bg_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/contentrl"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foregroundGravity="center">
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/btnrl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="@dimen/home_page_tile_min_height"
            android:foregroundGravity="center">
            <RelativeLayout
                android:id="@+id/rl_img_bg"
                android:background="@drawable/home_circle_bg"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginTop="5dp"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/btn"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_add_farmer"
                    android:tint="@color/colorPrimary"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/home_page_text1"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Add Farmer"
                android:layout_below="@+id/rl_img_bg"
                android:layout_centerHorizontal="true"/>
            <View
                android:id="@+id/border1"
                android:background="@color/home_card_border"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/title"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_descriptipn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/border1">
                <RelativeLayout
                    android:id="@+id/firstdescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp">
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/home_page_text1"
                        android:id="@+id/description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="fsadf"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/home_page_text1"
                        android:gravity="right"
                        android:id="@+id/count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22"
                        android:layout_toRightOf="@+id/description"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/seconddescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_toRightOf="@+id/firstdescription"
                    android:layout_below="@+id/btnrl"
                    android:layout_alignTop="@+id/firstdescription"
                    android:layout_alignBottom="@+id/firstdescription"
                    android:layout_centerVertical="true">
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/home_page_text1"
                        android:id="@+id/description1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="fasdf"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/home_page_text1"
                        android:gravity="right"
                        android:id="@+id/count1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="33"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/thirddescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_toRightOf="@+id/seconddescription"
                    android:layout_below="@+id/btnrl"
                    android:layout_alignTop="@+id/seconddescription"
                    android:layout_alignBottom="@+id/seconddescription">
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/home_page_text1"
                        android:id="@+id/description2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="fadsf"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:textColor="@color/home_page_text1"
                        android:gravity="right"
                        android:id="@+id/count2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22"
                        android:layout_toLeftOf="@+id/svDataRefresh"
                        android:layout_toRightOf="@+id/description2"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                    <ImageView
                        android:id="@+id/svDataRefresh"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="5dp"
                        android:src="@drawable/ic_action_refresh"
                        android:tint="@color/colorAccent"
                        android:layout_toRightOf="@+id/description2"/>
                    <ProgressBar
                        android:layout_gravity="center"
                        android:id="@+id/pbSvDataRefresh"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="5dp"
                        android:indeterminate="true"
                        android:progressDrawable="@color/colorAccent"
                        android:layout_toRightOf="@+id/description2"
                        android:indeterminateTint="@color/colorAccent"
                        android:indeterminateTintMode="src_atop"/>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/red_light_bg"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/tvalert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="Use online only"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
