<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_parent_inflater"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/barLayout"
        android:background="?attr/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/white"
            android:ellipsize="marquee"
            android:id="@+id/activityNameText"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="activity"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/barLayout">
        <Button
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/btnStartStop"
            android:background="@color/colorPrimary"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:text="Start"
            android:drawableRight="@drawable/timer"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tvDisplayTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="20dp"
            android:text="00:00:00"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/ield_inspections_opr_scroll"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_timer"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_infalter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <WebView
        android:id="@+id/webView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_timer"
        android:layout_alignParentBottom="true"/>
    <Button
        android:textColor="@color/white"
        android:id="@+id/BtnSave"
        android:background="@drawable/btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:minHeight="40dp"
        android:text="Submit"
        android:layout_alignParentBottom="true"/>
    <com.conceptglobal.imaterialdesign.widget.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/fab3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fab_margin"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        app:fab_iconSrc="@drawable/neo_campaign"
        app:v_styleId="@array/fab_icon"/>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
</RelativeLayout>
