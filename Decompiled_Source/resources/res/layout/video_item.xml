<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="2dp"
    android:layout_marginRight="5dp">
    <ImageView
        android:id="@+id/content_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        app:srcCompat="0x7f08015f"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_video_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paddy Harvesting Machine "
        android:layout_toLeftOf="@+id/tv_Test"
        android:layout_toRightOf="@+id/content_type"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/grey"
        android:id="@+id/tv_video_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="It is an engine operated, walk behind type harvester suitable for harvesting"
        android:layout_toLeftOf="@+id/tv_Test"
        android:layout_below="@+id/content_type"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="right"
        android:id="@+id/tv_Test"
        android:background="@drawable/btn_selection"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        android:text="Take Test"
        android:layout_alignParentRight="true"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/frame"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/tv_video_desc">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivTestCertified"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginLeft="-60dp"
            android:layout_marginTop="-25dp"/>
        <ImageView
            android:id="@+id/video_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="130dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/action_play"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:tint="@color/white"
            app:srcCompat="0x7f08016c"/>
        <TextView
            android:textStyle="bold"
            android:layout_gravity="bottom|right"
            android:id="@+id/duration"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:15"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1"
        android:layout_below="@+id/frame">
        <com.conceptglobal.pmc.promotions.utils.FlowLayout
            android:orientation="horizontal"
            android:id="@+id/chipsBoxLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_weight="0.8"
            app:flChildSpacing="5dp"
            app:flChildSpacingForLastRow="align"
            app:flRowSpacing="8dp"/>
        <com.conceptglobal.pmc.promotions.utils.ArrowDownloadButton
            android:layout_gravity="end"
            android:id="@+id/download"
            android:visibility="visible"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_weight="0.2"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/delete"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_weight="0.2"
            app:srcCompat="0x7f080135"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/light_red"
        android:layout_gravity="bottom|right"
        android:id="@+id/tvExpDate"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exp Date : 25-09-2020"
        android:layout_below="@+id/llChips"/>
    <View
        android:background="@color/grey"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/tvExpDate"/>
</RelativeLayout>
