<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/grey_text"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_img_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/edittext_height"
                android:text="Video"
                android:layout_weight="0.6"
                style="@style/text_hint"/>
            <VideoView
                android:layout_gravity="center"
                android:id="@+id/VideoView"
                android:background="@color/white"
                android:visibility="visible"
                android:layout_width="250dp"
                android:layout_height="110dp"
                android:layout_marginLeft="138dp"
                android:layout_marginTop="38dp"
                android:src="0x7f0801d0"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/img_preview"
                android:background="@color/white"
                android:layout_width="250dp"
                android:layout_height="110dp"
                android:layout_marginLeft="138dp"
                android:layout_marginTop="38dp"
                android:src="0x7f0801d0"
                android:layout_weight="0.4"
                android:layout_centerHorizontal="true"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="0.6">
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/grey_text"
                android:id="@+id/tv_edtsubjects"
                android:layout_width="287dp"
                android:layout_height="match_parent"
                android:minHeight="@dimen/edittext_height"
                android:hint="Subject"
                android:layout_weight="0.6"
                style="@style/text_hint"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:gravity="center"
                android:id="@+id/edtsubject"
                android:background="@drawable/edit"
                android:layout_width="288dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/edittext_height"
                android:hint="Comments"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
                android:layout_weight="0.4"
                style="@style/edit_text"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.conceptglobal.pmc.utils.Itext
                android:textColor="@color/grey_text"
                android:id="@+id/tv_edtprcomments"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="@dimen/edittext_height"
                android:text="Comments"
                android:layout_weight="0.6"
                style="@style/text_hint"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:gravity="center"
                android:id="@+id/edtprcomments"
                android:background="@drawable/edit"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/edittext_height"
                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"
                android:layout_weight="0.4"
                style="@style/edit_text"/>
            <Button
                android:textColor="#ffffff"
                android:id="@+id/recordvideo"
                android:background="@drawable/btn"
                android:visibility="visible"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="Start Recording"
                android:onClick="recordVideo"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/picturesavecancellayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <Button
                android:textColor="#ffffff"
                android:id="@+id/btnvideocancel"
                android:background="@drawable/btn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/pmc_cancel"
                android:layout_weight="0.5"
                android:onClick="cancelVideo"/>
            <Button
                android:textColor="#ffffff"
                android:id="@+id/btnvideosave"
                android:background="@drawable/btn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:text="@string/pmc_save"
                android:layout_weight="0.5"
                android:onClick="saveVideo"/>
            <Button
                android:textColor="#ffffff"
                android:id="@+id/btnpicturedelete"
                android:background="@drawable/btn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:text="Delete"
                android:layout_weight="0.5"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
