<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewSegmentTypeNameTODO"
    android:background="@color/red"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:layout_marginBottom="2dp"
    card_view:cardBackgroundColor="@android:color/white"
    card_view:cardElevation="2dp"
    card_view:cardUseCompatPadding="true"
    card_view:contentPadding="1dp">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/CustomerTypeMainLayout"
        android:background="@android:color/white"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:gravity="center"
            android:id="@+id/txtID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:gravity="center"
            android:id="@+id/txtNoDaysLeft"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtID"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/linearLayoutdateView"
            android:layout_below="@+id/txtNoDaysLeft">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textiv_status_farmer_Name"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textCustomerTypePhoneNo"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="13"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textCustomerTypeParentName"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textCustomerActivityName"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textCustomerAssingmentID"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/tv_actAssignId"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Text Here"
                android:layout_alignParentBottom="true"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/imageViewSegmentType"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="60dp"
            android:src="@drawable/phonedail"
            android:layout_below="@+id/txtNoDaysLeft"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayoutdateView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/imageViewSegmentType"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textFromDate"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textToDate"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/dark_red"
                android:gravity="center_vertical"
                android:id="@+id/textViewDaysLeft"
                android:padding="5dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/latlongs"
            android:visibility="invisible"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/map"
            android:layout_below="@+id/linearLayoutdateView"
            android:layout_alignStart="@+id/linearLayoutdateView"/>
        <ImageView
            android:id="@+id/iv_status_farmer_namess"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="0x7f080168"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/iv_deleteDraft"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/del_img"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
