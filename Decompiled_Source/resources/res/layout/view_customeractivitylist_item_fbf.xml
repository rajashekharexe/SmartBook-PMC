<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewSegmentTypeNameTODO"
    android:background="@color/red"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    card_view:cardBackgroundColor="@android:color/white"
    card_view:cardElevation="2dp"
    card_view:cardUseCompatPadding="true"
    card_view:contentPadding="2dp">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/CustomerTypeMainLayout"
        android:background="@android:color/white"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/linearLayoutdateView"
            android:layout_alignParentTop="true">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textiv_status_farmer_Name"
                android:padding="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer Name "/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textCustomerTypePhoneNo"
                android:padding="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="90301738102 "
                android:maxLength="13"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textCustomerTypeParentName"
                android:padding="2dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Village 1 - Mandal 1 "/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textCustomerActivityName"
                android:padding="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Small farmer Meeting"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textCustomerAssingmentID"
                android:padding="2dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Assignment ID"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/imageViewSegmentType"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginRight="60dp"
            android:src="@drawable/phonedail"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linearLayoutdateView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imageViewSegmentType"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textFromDate"
                android:padding="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From : 16/12/2015"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center_vertical"
                android:id="@+id/textToDate"
                android:padding="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To : 26/12/2015"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/dark_red"
                android:gravity="center_vertical"
                android:id="@+id/textViewDaysLeft"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Days Left"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/latlongs"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/map"
            android:layout_below="@+id/linearLayoutdateView"
            android:layout_alignStart="@+id/linearLayoutdateView"/>
        <ImageView
            android:id="@+id/iv_status_farmer_namess"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/img_save_status"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/iv_deleteDraft"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/del_img"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_below="@+id/linearLayout1">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:id="@+id/txtResolutionstatus"
                android:padding="2dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Status"
                android:layout_weight="1"/>
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/btn_resolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="View resolution"
                android:layout_weight="1"
                style="@style/btnStyleBreakerBay"/>
            <com.conceptglobal.pmc.utils.Ibutton
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/btn_forward"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="Forward"
                android:layout_weight="1"
                style="@style/btnStyleBreakerBay"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
