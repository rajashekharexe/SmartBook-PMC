<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/filtersVillList"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2">
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/ed_custType"
                android:background="@drawable/edt_disable"
                android:paddingLeft="10dp"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_margin="2dp"
                android:layout_marginTop="2dp"
                android:hint="Customer Type"
                android:drawableRight="@drawable/drop"
                android:layout_weight="1"
                style="@style/edit_text_disable"/>
            <TextView
                android:id="@+id/tvCustTypeId"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/ed_cropSearch"
                android:background="@drawable/edt_disable"
                android:paddingLeft="10dp"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_margin="2dp"
                android:layout_marginTop="2dp"
                android:hint="Crop"
                android:drawableRight="@drawable/drop"
                android:layout_weight="1"
                style="@style/edit_text_disable"/>
            <TextView
                android:id="@+id/tvCropId"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2">
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/ed_RadiusSearch"
                android:background="@drawable/edt_disable"
                android:paddingLeft="10dp"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_margin="2dp"
                android:layout_marginTop="2dp"
                android:hint="Radius(kms)"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <com.conceptglobal.pmc.utils.Iedit
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/ed_Brand"
                android:background="@drawable/edt_disable"
                android:paddingLeft="10dp"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_margin="2dp"
                android:layout_marginTop="2dp"
                android:hint="Brand"
                android:drawableRight="@drawable/drop"
                android:layout_weight="1"
                style="@style/edit_text_disable"/>
            <TextView
                android:id="@+id/tvBrandId"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/normal_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/filter_list_goBtn"
                android:paddingLeft="20dp"
                android:paddingTop="8dp"
                android:paddingRight="20dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go"
                style="@style/btnStyleBreakerBay"/>
            <com.conceptglobal.pmc.utils.Itext
                android:textSize="@dimen/normal_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/farmer_lsit_ClearBtn"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:text="Clear"
                style="@style/btnStyleBreakerBay"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.conceptglobal.pmc.utils.Itext
            android:textSize="12sp"
            android:textColor="@color/blue_gray"
            android:ellipsize="marquee"
            android:gravity="center_horizontal"
            android:id="@+id/tv_scroll_village_list"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fadingEdge="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_disc_texts"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.3">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/blue_gray"
                    android:id="@+id/tv_villagename_village_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    style="@style/text_list_header"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.4">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/blue_gray"
                    android:gravity="center"
                    android:id="@+id/tv_tbv_village_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/text_list_header"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.4">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/blue_gray"
                    android:id="@+id/tv_vc_village_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/text_list_header"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.4">
                <com.conceptglobal.pmc.utils.Itext
                    android:textColor="@color/blue_gray"
                    android:gravity="center"
                    android:id="@+id/tv_pd_village_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/text_list_header"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvFarmerOTPVerification"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_15"
            card_view:cardBackgroundColor="@android:color/white"
            card_view:cardCornerRadius="8dp"
            card_view:cardElevation="2dp"
            card_view:cardUseCompatPadding="true"
            card_view:contentPadding="10dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="4">
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tvActivityLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Farmer Verification code"
                    android:layout_weight="2.6"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/blue_gray"
                    android:gravity="center_horizontal"
                    android:id="@+id/tvWIPCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_15"
                    android:text=""
                    android:layout_weight="0.7"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/blue_gray"
                    android:gravity="center_horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_15"
                    android:text="0"
                    android:layout_weight="0.7"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvRetailerOTPVerification"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_15"
            card_view:cardBackgroundColor="@android:color/white"
            card_view:cardCornerRadius="8dp"
            card_view:cardElevation="2dp"
            card_view:cardUseCompatPadding="true"
            card_view:contentPadding="10dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="4">
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tvRetailerActivityLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Retailer  Verification Code"
                    android:layout_weight="2.6"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/blue_gray"
                    android:gravity="center_horizontal"
                    android:id="@+id/tvRetailerWIPCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_15"
                    android:text=""
                    android:layout_weight="0.7"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/blue_gray"
                    android:gravity="center_horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_15"
                    android:text="0"
                    android:layout_weight="0.7"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <ListView
            android:id="@+id/lv_village_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@color/grey_light"
            android:dividerHeight="1dp"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/loaderrl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/progressbar"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <TextView
            android:id="@+id/loadertxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="Loading..."
            android:layout_toRightOf="@+id/progressbar"/>
    </RelativeLayout>
</LinearLayout>
