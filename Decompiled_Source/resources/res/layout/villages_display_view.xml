<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_village_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ListView
            android:id="@+id/lv_village_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:divider="@color/grey_light"
            android:dividerHeight="6dp"/>
        <LinearLayout
            android:gravity="right"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <SlidingDrawer
                android:layout_gravity="right"
                android:id="@+id/sliding_drawer_village_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:handle="@+id/handleButton_village_display"
                android:content="@+id/contentLayout">
                <LinearLayout
                    android:gravity="right"
                    android:id="@+id/handleButton_village_display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">
                    <com.conceptglobal.pmc.utils.Itext
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_summery_village_display"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/pmc_string_activity_summary"
                        android:layout_weight="0.3"/>
                    <LinearLayout
                        android:gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.7">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/img_summery"
                            android:adjustViewBounds="true"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="top|center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/contentLayout"
                    android:background="@color/background_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:background="#c0c0c0"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.conceptglobal.pmc.utils.Itext
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="15dp"
                                android:text="@string/pmc_hint_disc_village_disp"
                                android:layout_weight="0.3"
                                style="@style/text_activity_list"/>
                            <com.conceptglobal.pmc.utils.Itext
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="15dp"
                                android:text="@string/pmc_hint_count_village_disp"
                                android:layout_weight="0.7"
                                style="@style/text_activity_list"/>
                        </LinearLayout>
                        <ListView
                            android:id="@+id/lv_details_village_display"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="10dp"/>
                    </LinearLayout>
                </LinearLayout>
            </SlidingDrawer>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
