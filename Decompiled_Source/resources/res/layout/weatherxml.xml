<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/card_layout_done"
        android:padding="5dp"
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:layout_margin="5dp">
        <TextView
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:id="@+id/dayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="Day Text"
            android:singleLine="true"
            android:layout_alignParentLeft="false"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/wthrImage"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="5dp"
            android:layout_below="@+id/dayText"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/tempText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="35"
            android:singleLine="true"
            android:layout_toRightOf="@+id/wthrImage"
            android:layout_alignTop="@+id/wthrImage"
            android:layout_toEndOf="@+id/wthrImage"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:id="@+id/DescText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:singleLine="true"
            android:layout_below="@+id/wthrImage"
            android:layout_alignLeft="@+id/wthrImage"
            android:layout_alignStart="@+id/wthrImage"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/minmaxTempText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="26/31"
            android:singleLine="true"
            android:layout_below="@+id/DescText"
            android:layout_alignLeft="@+id/DescText"
            android:layout_alignStart="@+id/DescText"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/huimidityText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Humidity"
            android:singleLine="true"
            android:layout_below="@+id/minmaxTempText"
            android:layout_alignLeft="@+id/minmaxTempText"
            android:layout_alignParentLeft="false"
            android:layout_alignStart="@+id/minmaxTempText"
            android:layout_alignParentStart="false"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/windText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Wind"
            android:singleLine="true"
            android:layout_below="@+id/huimidityText"
            android:layout_alignLeft="@+id/huimidityText"
            android:layout_alignStart="@+id/huimidityText"/>
    </RelativeLayout>
</RelativeLayout>
