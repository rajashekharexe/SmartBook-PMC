<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppBaseTheme" parent="@style/Theme.AppCompat.Light">
    </style>
    <style name="DarkBodyText" parent="">
        <item name="android:textAppearance">@style/Base.TextAppearance.AppCompat.Body1</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">#ffffffff</item>
    </style>
    <style name="DarkEditText" parent="@style/Material.Widget.EditText">
        <item name="android:textAppearance">@style/Base.TextAppearance.AppCompat.Body1</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/abc_primary_text_material_dark</item>
        <item name="android:textColorHint">@color/abc_secondary_text_material_dark</item>
        <item name="et_dividerColor">@drawable/color_divider_dark</item>
        <item name="et_dividerErrorColor">#ffff0000</item>
        <item name="et_labelTextColor">@drawable/color_label_dark</item>
        <item name="et_supportTextErrorColor">#ffff0000</item>
    </style>
    <style name="DarkTabPageIndicator" parent="@style/Material.Widget.TabPageIndicator">
        <item name="android:textAppearance">@style/DarkTabTextAppearance</item>
        <item name="android:gravity">fill_horizontal</item>
        <item name="android:background">@color/colorAccent</item>
        <item name="tpi_indicatorColor">?attr/colorPrimary</item>
        <item name="tpi_indicatorHeight">3dp</item>
        <item name="tpi_mode">fixed</item>
        <item name="tpi_tabPadding">8dp</item>
        <item name="tpi_tabRipple">@style/DarkTabRippleStyle</item>
    </style>
    <style name="DarkTabTextAppearance" parent="@style/Base.TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">@dimen/heading_text_size</item>
        <item name="android:textColor">@drawable/color_tpi_dark</item>
    </style>
    <style name="DarkTitleText" parent="">
        <item name="android:textAppearance">@style/Base.TextAppearance.AppCompat.Title</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">#ffffffff</item>
        <item name="android:padding">8dp</item>
    </style>
    <style name="LightEditText" parent="@style/Material.Widget.EditText.Light">
        <item name="android:textAppearance">@style/Base.TextAppearance.AppCompat.Body1</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/abc_primary_text_material_light</item>
        <item name="android:textColorHint">@color/abc_secondary_text_material_light</item>
        <item name="et_dividerColor">@drawable/color_divider_light</item>
        <item name="et_dividerErrorColor">#ffff0000</item>
        <item name="et_labelTextColor">@drawable/color_label_light</item>
        <item name="et_supportTextErrorColor">#ffff0000</item>
    </style>
    <style name="LightRaiseWaveColorButtonRippleStyle" parent="@style/Material.Drawable.Ripple.Wave.Light">
        <item name="android:textAppearance">@style/Base.TextAppearance.AppCompat.Button</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/abc_primary_text_material_dark</item>
        <item name="android:background">?attr/colorPrimary</item>
        <item name="rd_bottomPadding">2dp</item>
        <item name="rd_delayClick">afterRelease</item>
        <item name="rd_leftPadding">1dp</item>
        <item name="rd_rightPadding">1dp</item>
        <item name="rd_rippleColor">#33000000</item>
        <item name="rd_topPadding">1dp</item>
    </style>
    <style name="LightTabPageIndicator" parent="@style/Material.Widget.TabPageIndicator">
        <item name="android:textAppearance">@style/LightTabTextAppearance</item>
        <item name="android:gravity">fill_horizontal</item>
        <item name="android:background">?attr/colorPrimary</item>
        <item name="tpi_indicatorColor">?attr/colorAccent</item>
        <item name="tpi_indicatorHeight">3dp</item>
        <item name="tpi_mode">fixed</item>
        <item name="tpi_tabPadding">8dp</item>
        <item name="tpi_tabRipple">@style/LightTabRippleStyle</item>
    </style>
    <style name="LightTabTextAppearance" parent="@style/Base.TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">@dimen/heading_text_size</item>
        <item name="android:textColor">@drawable/color_tpi_light</item>
    </style>
    <style name="MenuItems" parent="@style/AppTheme">
        <item name="android:textSize">32sp</item>
    </style>
    <style name="btnStyleBreakerBay" parent="@android:style/Widget.Button">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/custom_btn</item>
        <item name="android:padding">10dp</item>
        <item name="android:shadowColor">#11b8b2</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">0.6</item>
    </style>
    <style name="btnStyleBreakerBayOrange" parent="@android:style/Widget.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:shadowColor">#11b8b2</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">0.6</item>
    </style>
    <style name="btnStyleBreakerBayRed" parent="@android:style/Widget.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:shadowColor">#11b8b2</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">0.6</item>
    </style>
    <style name="btnStyleBreakerBayWithOutPadding" parent="@android:style/Widget.Button">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/custom_btn</item>
        <item name="android:shadowColor">#11b8b2</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">0.6</item>
    </style>
    <style name="edit_text" parent="">
        <item name="android:textSize">25sp</item>
        <item name="android:paddingLeft">10dp</item>
    </style>
    <style name="text_activity_village_list" parent="">
        <item name="android:textSize">@dimen/heading_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1e1e1e</item>
    </style>
    <style name="text_heading" parent="">
        <item name="android:textSize">50sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#125156</item>
    </style>
    <style name="text_list_header" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/actionbar_blue</item>
    </style>
    <style name="text_noraml" parent="">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#000000</item>
    </style>
    <style name="text_report" parent="">
        <item name="android:textSize">@dimen/card_item_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#1e1e1e</item>
    </style>
    <style name="text_sub_details" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#125156</item>
    </style>
</resources>
