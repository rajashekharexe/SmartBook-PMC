        <TextView android:gravity="center" android:layout_gravity="center" android:id="@id/tvBanner" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="0.0dip" android:text="No Banners." android:layout_weight="1.4" />
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@id/SliderDots" android:layout_width="fill_parent" android:layout_height="wrap_content" />
        <TextView android:gravity="center" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/recenty_published" />
        <androidx.recyclerview.widget.RecyclerView android:id="@id/recently_published_promotions" android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_weight="1.3" />
